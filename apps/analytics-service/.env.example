# Analytics service env. Pydantic-settings strips the ACCELERATOR_ prefix
# (env_prefix is set in app/infra/config.py). Bare names like GEMINI_API_KEY
# are NOT picked up — the prefix is required.

# Server
ACCELERATOR_HOST=0.0.0.0
ACCELERATOR_PORT=8001
ACCELERATOR_RELOAD=true
ACCELERATOR_LOG_LEVEL=info
ACCELERATOR_DEBUG=false

# Postgres
ACCELERATOR_DB_HOST=localhost
ACCELERATOR_DB_PORT=5432
ACCELERATOR_DB_USER=accelerator
ACCELERATOR_DB_PASSWORD=
ACCELERATOR_DB_NAME=accelerator

# Mongo (PromptLab sessions/runs/eval_cache). Single URL, no auth needed for local.
ACCELERATOR_MONGO_URL=mongodb://localhost:27017
ACCELERATOR_MONGO_DB=promptlab

# Storage
ACCELERATOR_STORAGE_DIR=/tmp/accelerator
ACCELERATOR_STORAGE_BACKEND=local
# ACCELERATOR_S3_BUCKET=
# ACCELERATOR_S3_PREFIX=
# ACCELERATOR_S3_REGION=us-east-1

# AI/LLM — required for /prompt-lab/evaluate
ACCELERATOR_GEMINI_API_KEY=
ACCELERATOR_OPENAI_API_KEY=
ACCELERATOR_ANTHROPIC_API_KEY=

# Optional company LLM proxy
# ACCELERATOR_LLM_PROXY_BASE_URL=
# ACCELERATOR_LLM_PROXY_PROJECT=
# ACCELERATOR_SSL_CERT_FILE=
