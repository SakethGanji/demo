          {
            "id": "t_c9d82f61",
            "name": "Premier customers have a higher limit",
            "target": {
              "kind": "workflow"
            },
            "input": {
              "items": [
                {
                  "customer_email": "dana@example.com",
                  "amount": 900,
                  "reason": "parcel arrived damaged",
                  "segment": "premier"
                }
              ]
            },
            "mocks": {
              "Classify reason": {
                "items": [
                  {
                    "response": "ok",
                    "structured": {
                      "category": "not_received"
                    },
                    "toolCalls": [],
                    "iterations": 1
                  }
                ]
              },
