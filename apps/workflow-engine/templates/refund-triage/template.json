                    "limit": 500,
                    "eligible": true
                  }
                ]
              },
              "Issue refund": {
                "http": {
                  "status": 201,
                  "body": {
                    "refund_id": "RF-1001",
                    "status": "issued"
                  }
                }
              },
              "Notify issued": {
                "items": [
                  {
                    "delivered": true,
                    "channel": "email"
                  }
                ]
              }
            },
            "expect": [
              {
                "node": "Manager approval",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              },
              {
                "node": "Issue refund",
                "subject": "request",
                "item": "any",
                "path": "body.amount",
                "op": "eq",
                "value": 200
              },
              {
                "node": "Issue refund",
                "subject": "request",
                "item": "any",
                "path": "body.customer_email",
                "op": "eq",
                "value": "dana@example.com"
              },
              {
                "node": "Notify issued",
                "subject": "node",
                "op": "status",
                "value": "success"
              },
              {
                "node": "Show result",
                "subject": "node",
                "op": "status",
                "value": "success"
              }
            ],
            "category": "normal",
            "status": "approved",
            "source": "human"
          },
          {
