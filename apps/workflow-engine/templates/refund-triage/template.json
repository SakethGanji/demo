{
  "format": "wf-template/1",
  "slug": "refund-triage",
  "version": "1.0.0",
  "name": "Refund triage with manager approval",
  "summary": "Classify refund requests, pay small ones at once and send larger ones to a manager.",
  "category": "payments",
  "tags": [
    "refunds",
    "approval",
    "form",
    "sub-workflow"
  ],
  "min_engine_stage": 8,
  "requires": {
    "templates": [
      {
        "slug": "customer-notify",
        "version": "^1"
      }
    ],
    "secrets": [
      {
        "name": "REFUNDS_API_KEY",
        "used_by": [
          "main/Issue refund"
        ]
      }
    ],
    "variables": [],
    "egress_hosts": [
      "refunds.bank.example"
    ]
  },
  "apis": [
    {
      "key": "refunds",
      "name": "refunds",
      "file": "apis/refunds.yaml"
    }
  ],
  "tables": [
    {
      "key": "refund_limits",
      "name": "refund_limits",
      "description": "Refund amount a customer segment gets without a manager",
      "columns": [
        {
          "name": "segment",
          "type": "string",
          "required": true
        },
        {
          "name": "auto_limit",
          "type": "number",
          "required": true
        }
      ],
      "seed_rows": [
        {
          "segment": "retail",
          "auto_limit": 500
        },
        {
          "segment": "premier",
          "auto_limit": 2000
        }
      ]
    }
  ],
  "workflows": [
    {
      "key": "main",
      "role": "entry",
      "name": "Refund triage",
      "publish": false,
      "description": "A refund request form: small refunds are paid at once, larger ones wait for a manager.",
      "definition": {
        "nodes": [
          {
            "name": "Refund request",
            "type": "FormTrigger",
            "parameters": {
              "title": "Request a refund",
              "submit_label": "Send request",
              "input_schema": {
                "type": "object",
                "required": [
                  "customer_email",
                  "amount",
                  "reason",
                  "segment"
                ],
                "properties": {
                  "customer_email": {
                    "type": "string",
                    "title": "Customer email"
                  },
                  "amount": {
                    "type": "number",
                    "title": "Amount"
                  },
                  "reason": {
                    "type": "string",
                    "title": "Reason"
                  },
                  "segment": {
                    "type": "string",
                    "title": "Segment"
                  }
                }
              }
            },
            "position": {
              "x": 0,
              "y": 0
            }
          },
          {
            "name": "Check eligibility",
            "type": "ExecuteWorkflow",
            "parameters": {
              "workflowId": "@tpl:workflow/eligibility",
              "version": "latest",
              "inputMode": "map",
              "mode": "once",
              "inputs": {
                "customer_email": "{{ $json.customer_email }}",
                "amount": "{{ $json.amount }}",
                "reason": "{{ $json.reason }}",
                "segment": "{{ $json.segment }}"
              }
            },
            "position": {
              "x": 240,
              "y": 0
            }
          },
          {
            "name": "Eligible?",
            "type": "If",
            "parameters": {
              "condition": "{{ $json.eligible }}"
            },
            "position": {
              "x": 480,
              "y": 0
            }
          },
          {
            "name": "Manager approval",
            "type": "Approval",
            "parameters": {
              "title": "Refund of {{ $json.amount }} needs a manager",
              "context": {
                "Customer": "{{ $json.customer_email }}",
                "Amount": "{{ $json.amount }}",
                "Reason": "{{ $json.reason }}",
                "Category": "{{ $json.category }}",
                "Automatic limit": "{{ $json.limit }}"
              },
              "require_comment_on_reject": true
            },
            "position": {
              "x": 720,
              "y": 120
            }
          },
          {
            "name": "Issue refund",
            "type": "HttpRequest",
            "parameters": {
              "api_ref": {
                "spec_id": "@tpl:api/refunds",
                "operation_id": "issueRefund"
              },
              "method": "POST",
              "responseType": "json",
              "headers": [
                {
                  "name": "Authorization",
                  "value": "Bearer {{ $vars.REFUNDS_API_KEY }}"
                }
              ],
              "body": {
                "customer_email": "{{ $node[\"Check eligibility\"].json.customer_email }}",
                "amount": "{{ $node[\"Check eligibility\"].json.amount }}",
                "reason": "{{ $node[\"Check eligibility\"].json.reason }}"
              }
            },
            "position": {
              "x": 960,
              "y": 0
            }
          },
          {
            "name": "Refund accepted?",
            "type": "If",
            "parameters": {
              "condition": "{{ $json.statusCode == 201 }}"
            },
            "position": {
              "x": 1200,
              "y": 0
            }
          },
          {
            "name": "Notify issued",
            "type": "ExecuteWorkflow",
            "parameters": {
              "workflowId": "@tpl:workflow/customer-notify:notify",
              "version": "latest",
              "inputMode": "map",
              "inputs": {
                "to": "{{ $node[\"Check eligibility\"].json.customer_email }}",
                "channel": "email",
                "template": "refund_issued",
                "vars": {
                  "amount": "{{ $node[\"Check eligibility\"].json.amount }}",
                  "reference": "{{ $node[\"Issue refund\"].json.body.refund_id }}"
                }
              },
              "mode": "once"
            },
            "position": {
              "x": 1440,
              "y": -80
            }
          },
          {
            "name": "Notify declined",
            "type": "ExecuteWorkflow",
            "parameters": {
              "workflowId": "@tpl:workflow/customer-notify:notify",
              "version": "latest",
              "inputMode": "map",
              "inputs": {
                "to": "{{ $json.customer_email }}",
                "channel": "email",
                "template": "refund_declined",
                "vars": {
                  "reason": "{{ $json.approval.comment }}"
                }
              },
              "mode": "once"
            },
            "position": {
              "x": 960,
              "y": 200
            }
          },
          {
            "name": "Notify failed",
            "type": "ExecuteWorkflow",
            "parameters": {
              "workflowId": "@tpl:workflow/customer-notify:notify",
              "version": "latest",
              "inputMode": "map",
              "inputs": {
                "to": "{{ $node[\"Check eligibility\"].json.customer_email }}",
                "channel": "email",
                "template": "refund_failed",
                "vars": {}
              },
              "mode": "once"
            },
            "position": {
              "x": 1440,
              "y": 80
            }
          },
          {
            "name": "Show result",
            "type": "Respond",
            "parameters": {
              "statusCode": 200,
              "body": {
                "message": "Your refund request was processed",
                "notified": "{{ $json.delivered }}"
              }
            },
            "position": {
              "x": 1680,
              "y": 0
            }
          }
        ],
        "connections": [
          {
            "source_node": "Refund request",
            "target_node": "Check eligibility",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Check eligibility",
            "target_node": "Eligible?",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Eligible?",
            "target_node": "Issue refund",
            "source_output": "true",
            "target_input": "main"
          },
          {
            "source_node": "Eligible?",
            "target_node": "Manager approval",
            "source_output": "false",
            "target_input": "main"
          },
          {
            "source_node": "Manager approval",
            "target_node": "Issue refund",
            "source_output": "approved",
            "target_input": "main"
          },
          {
            "source_node": "Manager approval",
            "target_node": "Notify declined",
            "source_output": "rejected",
            "target_input": "main"
          },
          {
            "source_node": "Issue refund",
            "target_node": "Refund accepted?",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Refund accepted?",
            "target_node": "Notify issued",
            "source_output": "true",
            "target_input": "main"
          },
          {
            "source_node": "Refund accepted?",
            "target_node": "Notify failed",
            "source_output": "false",
            "target_input": "main"
          },
          {
            "source_node": "Notify issued",
            "target_node": "Show result",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Notify declined",
            "target_node": "Show result",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Notify failed",
            "target_node": "Show result",
            "source_output": "main",
            "target_input": "main"
          }
        ],
        "settings": {},
        "tests": [
          {
            "id": "t_3225ca74",
            "name": "A small refund is paid and the customer is told",
            "target": {
              "kind": "workflow"
            },
            "input": {
