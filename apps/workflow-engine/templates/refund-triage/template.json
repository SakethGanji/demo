          }
        ],
        "test_defaults": {},
        "interface": {
          "kind": "form",
          "slug": "refund-triage",
          "title": "Request a refund",
          "description": "",
          "access": {
            "mode": "public"
          },
          "trigger_node": "Refund request",
          "result_node": "Show result"
        }
      }
    },
    {
      "key": "eligibility",
      "role": "subworkflow",
      "name": "Refund eligibility",
      "publish": true,
      "description": "Classify the reason, look up the customer segment's automatic limit and say whether the refund can be paid without a manager.",
      "definition": {
        "nodes": [
          {
            "name": "Inputs",
            "type": "ExecuteWorkflowTrigger",
            "parameters": {
              "inputSource": "fields",
              "fields": [
                {
                  "name": "customer_email",
                  "type": "string",
                  "required": true,
                  "description": "Customer email"
                },
                {
                  "name": "amount",
                  "type": "number",
                  "required": true,
                  "description": "Refund amount"
                },
                {
                  "name": "reason",
                  "type": "string",
                  "required": true,
                  "description": "Why the customer wants a refund"
                },
                {
                  "name": "segment",
                  "type": "string",
                  "required": true,
                  "description": "retail or premier"
                }
              ]
            },
            "position": {
              "x": 0,
              "y": 0
            }
          },
          {
            "name": "Classify reason",
            "type": "AIAgent",
            "parameters": {
              "model": "claude-sonnet-4-20250514",
              "systemPrompt": "You classify a bank customer's refund request. Answer with exactly one category: damaged, not_received, changed_mind, fraud or other. Never decide whether to pay.",
              "task": "Customer's reason: {{ $node[\"Inputs\"].json.reason }}",
              "outputSchema": {
                "type": "object",
                "required": [
                  "category"
                ],
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "damaged",
                      "not_received",
                      "changed_mind",
                      "fraud",
                      "other"
                    ]
                  }
                }
              }
            },
            "position": {
              "x": 240,
              "y": 0
            },
            "on_error": "error_output"
          },
          {
            "name": "Look up limit",
            "type": "DataTable",
            "parameters": {
              "table": "@tpl:table/refund_limits",
              "operation": "list",
              "filter": {
                "segment": "{{ $node[\"Inputs\"].json.segment }}"
              },
              "limit": 1
            },
            "position": {
              "x": 480,
              "y": -80
            }
          },
          {
            "name": "Decide",
            "type": "Set",
            "parameters": {
              "mode": "json",
              "keepOnlySet": true,
              "jsonData": {
                "customer_email": "{{ $node[\"Inputs\"].json.customer_email }}",
                "amount": "{{ $node[\"Inputs\"].json.amount }}",
                "reason": "{{ $node[\"Inputs\"].json.reason }}",
                "category": "{{ $node[\"Classify reason\"].json.structured.category }}",
                "limit": "{{ $json.auto_limit }}",
                "eligible": "{{ $node[\"Inputs\"].json.amount <= $json.auto_limit and $node[\"Classify reason\"].json.structured.category != 'fraud' }}"
              }
            },
            "position": {
              "x": 720,
              "y": -80
            }
          },
          {
            "name": "AI unavailable",
            "type": "Set",
            "parameters": {
              "mode": "json",
              "keepOnlySet": true,
              "jsonData": {
                "customer_email": "{{ $node[\"Inputs\"].json.customer_email }}",
                "amount": "{{ $node[\"Inputs\"].json.amount }}",
                "reason": "{{ $node[\"Inputs\"].json.reason }}",
                "category": "unclassified",
                "limit": 0,
                "eligible": false
              }
            },
            "position": {
              "x": 480,
              "y": 100
            }
          }
        ],
        "connections": [
          {
            "source_node": "Inputs",
            "target_node": "Classify reason",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Classify reason",
            "target_node": "Look up limit",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Look up limit",
            "target_node": "Decide",
            "source_output": "main",
            "target_input": "main"
          },
          {
            "source_node": "Classify reason",
            "target_node": "AI unavailable",
            "source_output": "error",
            "target_input": "main"
          }
        ],
        "settings": {},
        "tests": [
          {
            "id": "t_481f73a1",
            "name": "A small retail refund is eligible",
            "target": {
              "kind": "workflow"
            },
            "input": {
              "items": [
                {
                  "customer_email": "dana@example.com",
                  "amount": 200,
                  "reason": "parcel arrived damaged",
                  "segment": "retail"
                }
              ]
            },
            "mocks": {
              "Classify reason": {
                "items": [
                  {
                    "response": "ok",
                    "structured": {
                      "category": "damaged"
                    },
                    "toolCalls": [],
                    "iterations": 1
                  }
                ]
              },
              "Look up limit": {
                "items": [
                  {
                    "id": 1,
                    "segment": "retail",
                    "auto_limit": 500
                  }
                ]
              }
            },
            "expect": [
              {
                "node": "Decide",
                "port": "main",
                "path": "eligible",
                "op": "eq",
                "value": true
              },
              {
                "node": "Decide",
                "port": "main",
                "path": "limit",
                "op": "eq",
                "value": 500
              },
              {
                "node": "Decide",
                "port": "main",
                "path": "category",
                "op": "eq",
                "value": "damaged"
              },
              {
                "node": "AI unavailable",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              }
            ],
            "category": "normal",
            "status": "approved",
            "source": "human"
          },
          {
            "id": "t_4e39f78a",
