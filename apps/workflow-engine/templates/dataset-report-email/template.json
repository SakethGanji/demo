                        "unique_count": 118,
                        "min": 1,
                        "max": 120,
                        "mean": 60.5,
                        "std": 34.8,
                        "top_values": []
                      },
                      {
                        "name": "email",
                        "dtype": "text",
                        "count": 120,
                        "null_count": 7,
                        "null_percent": 5.83,
                        "unique_count": 101,
                        "top_values": []
                      },
                      {
                        "name": "amount",
                        "dtype": "numeric",
                        "count": 120,
                        "null_count": 0,
                        "null_percent": 0.0,
                        "unique_count": 95,
                        "min": 2.5,
                        "max": 9800.0,
                        "mean": 140.2,
                        "std": 610.4,
                        "top_values": []
                      }
                    ]
                  }
                ]
              },
              "Analyse profile": {
                "error": {
                  "message": "The model is unavailable.",
                  "code": "LLM_ERROR"
                }
              }
            },
            "expect": [
              {
                "node": "Analyse profile",
                "subject": "node",
                "op": "status",
                "value": "error"
              },
              {
                "node": "Build report",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              },
              {
                "node": "Email report",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              }
            ],
            "category": "ext_error",
            "status": "approved",
            "source": "human"
          },
          {
            "id": "t_4a7e2b91",
            "name": "A refused email fails the run with the server's reason",
            "target": {
              "kind": "workflow"
            },
            "input": {
