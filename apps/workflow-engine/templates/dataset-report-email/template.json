                    "columns": [
                      {
                        "name": "order_id",
                        "dtype": "numeric",
                        "count": 120,
                        "null_count": 0,
                        "null_percent": 0.0,
                        "unique_count": 118,
                        "min": 1,
                        "max": 120,
                        "mean": 60.5,
                        "std": 34.8,
                        "top_values": []
                      },
                      {
                        "name": "email",
                        "dtype": "text",
                        "count": 120,
                        "null_count": 7,
                        "null_percent": 5.83,
                        "unique_count": 101,
                        "top_values": []
                      },
                      {
                        "name": "amount",
                        "dtype": "numeric",
                        "count": 120,
                        "null_count": 0,
                        "null_percent": 0.0,
                        "unique_count": 95,
                        "min": 2.5,
                        "max": 9800.0,
                        "mean": 140.2,
                        "std": 610.4,
                        "top_values": []
                      }
                    ]
                  }
                ]
              },
              "Analyse profile": {
                "items": [
                  {
                    "response": "## Overview\nA small, clean dataset.\n\n## Recommendations\n- Nothing to fix.\n"
                  }
                ]
              },
              "Email report": {
                "items": [
                  {
                    "success": true,
                    "sent": true,
                    "to": "reports@example.com",
                    "subject": "Dataset report",
                    "html": "<!DOCTYPE html>...",
                    "message_id": "<report-1@example.com>"
                  }
                ]
              }
            },
            "expect": [
              {
                "node": "Build report",
                "port": "main",
                "path": "html",
                "op": "contains",
                "value": "Overview</h2>"
              },
              {
                "node": "Build report",
                "port": "main",
                "path": "html",
                "op": "contains",
                "value": "<ul"
              },
              {
                "node": "Build report",
                "port": "main",
                "path": "text",
                "op": "contains",
                "value": "- Nothing to fix."
              },
              {
                "node": "Email report",
                "subject": "node",
                "op": "status",
                "value": "success"
              }
            ],
            "category": "unusual",
            "status": "approved",
            "source": "human"
          },
          {
            "id": "t_b51f0e72",
            "name": "The analytics service failing stops the run before the LLM",
            "target": {
              "kind": "workflow"
            },
            "input": {
              "items": [
                {}
              ]
            },
            "mocks": {
              "Profile dataset": {
                "error": {
                  "message": "No dataset named 'sales' in this project.",
                  "code": "DATASET_NOT_FOUND"
                }
              }
            },
            "expect": [
              {
                "node": "Profile dataset",
                "subject": "node",
                "op": "status",
                "value": "error"
              },
              {
                "node": "Analyse profile",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              },
              {
                "node": "Email report",
                "subject": "node",
                "op": "status",
                "value": "not_run"
              }
            ],
            "category": "ext_error",
            "status": "approved",
            "source": "human"
          },
          {
            "id": "t_d09c6a3f",
            "name": "An LLM failure sends no email",
            "target": {
              "kind": "workflow"
            },
            "input": {
              "items": [
                {}
              ]
            },
            "mocks": {
              "Profile dataset": {
                "items": [
                  {
                    "success": true,
                    "row_count": 120,
                    "column_count": 3,
                    "memory_usage_bytes": 4096,
