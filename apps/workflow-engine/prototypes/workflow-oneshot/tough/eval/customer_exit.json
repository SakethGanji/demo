{
 "id": "customer_exit",
 "request": "When a customer leaves the bank, staff call a webhook with customer_id. In core banking, read the customer's open accounts and their active loans. If any open account has a balance other than zero, or the customer has any active loan, reply 409 with {status: 'blocked', blockers: [...]} listing every blocking account id and loan id, and stop. Otherwise the ops manager (OPS_MANAGER_EMAIL) approves the exit, seeing the customer id and the list of accounts. Once approved, close every open account through core banking, and for each one record in ops_db, in one transaction per account, an account_closures row (account id, customer id) and an audit_log row (entity 'account', the account id, action 'closed'). Reply 200 {status: 'closed', accounts: <how many were closed>}. If the manager rejects, reply 200 {status: 'rejected'} and close nothing.",
 "apis": [
  "corebank.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "Webhook",
  "must_have_types": [
   "Postgres",
   "Approval",
   "Respond"
  ],
  "must_call": [
   "corebank.closeAccount"
  ],
  "max_nodes": 22
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
