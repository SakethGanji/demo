         "product": "savings",
         "balance": "0.00",
         "status": "open"
        },
        {
         "account_id": "A2",
         "customer_id": "CU8",
         "product": "savings",
         "balance": "0",
         "status": "open"
        },
        {
         "account_id": "A3",
         "customer_id": "CU8",
         "product": "savings",
         "balance": "0.00",
         "status": "open"
        }
       ],
       "rowCount": 3
      }
     ]
    },
    "$pg:loans!accounts": {
     "items": [
      {
       "rows": [],
       "rowCount": 0
      }
     ]
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$api:corebank.closeAccount": {
     "http": {
      "status": 200,
      "body": {
       "account_id": "{{ $json.account_id }}",
       "status": "closed"
      }
     }
    },
    "$pgw:account_closures": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$all:Approval?",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$api:corebank.closeAccount",
     "subject": "request",
     "op": "count",
     "value": 3
    },
    {
     "node": "$api:corebank.closeAccount",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "A2"
    },
    {
     "node": "$api:corebank.closeAccount",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "A3"
    },
    {
     "node": "$pgw:account_closures",
     "subject": "request",
     "op": "count",
     "value": 3
    },
    {
     "node": "$pgw:account_closures",
     "subject": "request",
     "item": "any",
     "path": "values",
     "op": "contains",
     "value": "A3"
    },
    {
     "node": "$pgw:account_closures",
     "subject": "request",
     "item": "all",
     "path": "sql",
     "op": "contains",
     "value": "audit_log"
    },
    {
     "node": "$pgw:account_closures",
     "subject": "request",
     "item": "all",
     "path": "values",
     "op": "contains",
     "value": "CU8"
    },
    {
     "node": "$all:Respond",
     "subject": "request",
     "item": "any",
     "path": "body.status",
     "op": "eq",
     "value": "closed"
    },
    {
     "node": "$all:Respond",
     "subject": "request",
     "item": "any",
     "path": "body.accounts",
     "op": "eq",
     "value": 3
    },
    {
     "node": "$all:Respond",
     "subject": "request",
     "op": "count",
     "value": 1
    }
   ]
