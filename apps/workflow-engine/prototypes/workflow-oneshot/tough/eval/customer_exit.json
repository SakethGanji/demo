 "subworkflows": [
  {
   "id": "wf_notify_customer",
   "name": "Notify customer",
   "description": "Sends a customer a message on their preferred channel and logs it.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "message",
     "type": "string",
     "required": true
