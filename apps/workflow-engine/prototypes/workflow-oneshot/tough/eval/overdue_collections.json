      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "sent",
         "value": "{{ true }}"
        },
        {
         "name": "channel",
         "value": "sms"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  }
