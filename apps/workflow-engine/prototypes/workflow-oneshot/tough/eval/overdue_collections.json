{
 "id": "overdue_collections",
 "request": "Every weekday at 7am, find the active loans in core banking that are 30 or more days past due, with each customer's email. For each loan: 30 to 59 days past due, email the customer a payment reminder (stage 'reminder'); 60 to 89, email the customer a final notice and also email the loan's officer (officer_email) (stage 'final_notice'); 90 or more, hand it to the collections agency with its outstanding amount (stage 'collections'). Record each loan's action in ops_db collection_actions (loan id and stage), one row per loan. Finally, email COLLECTIONS_LEAD_EMAIL one summary saying how many loans went to each stage. If no loans are overdue, send nothing at all.",
 "apis": [
  "collections.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "Cron",
  "must_have_types": [
   "Postgres",
   "SendEmail"
  ],
  "must_call": [
   "collections.openCase"
  ],
  "max_nodes": 24
 },
