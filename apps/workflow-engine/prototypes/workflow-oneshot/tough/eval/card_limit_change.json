 "subworkflows": [
  {
   "id": "wf_notify_customer",
   "name": "Notify customer",
   "description": "Sends a customer a message on their preferred channel and logs it.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "message",
     "type": "string",
     "required": true
    }
   ],
   "output_fields": [
    "sent",
    "channel"
   ],
   "definition": {
    "name": "child",
    "nodes": [
     {
      "name": "Called",
      "type": "ExecuteWorkflowTrigger",
      "parameters": {
       "inputSource": "fields",
       "fields": [
        {
         "name": "customer_id",
         "type": "string",
         "required": true
        },
        {
         "name": "message",
         "type": "string",
         "required": true
        }
       ]
      }
     },
     {
      "name": "Result",
      "type": "Set",
      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "sent",
         "value": "{{ true }}"
        },
        {
         "name": "channel",
         "value": "sms"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  }
 ],
