     "node": "$nth:Approval::1",
     "subject": "request",
     "op": "count",
     "value": 2
    },
    {
     "node": "$api:iam.revoke",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$api:iam.revoke",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "u3"
