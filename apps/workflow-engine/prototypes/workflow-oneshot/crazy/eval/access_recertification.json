{
 "id": "access_recertification",
 "request": "On the first day of each quarter, read every user's access from iam_db user_access and group it by manager. Each manager gets their own task (sent to the manager's email, due in 7 days) listing their people's user ids and systems, where they enter revoke: a comma-separated list of the user ids to remove (empty keeps everyone). If a manager hasn't answered in 7 days, email them a reminder and give them a second task, due in 3 days. If that runs out too, revoke access for all of that manager's users and email CISO_EMAIL naming the manager. Revoke each listed user through the IAM API. Record each manager's outcome in ops_db audit_log (entity 'recert', the manager's email, action 'confirmed' when nobody was revoked, 'revoked_some', or 'revoked_all_timeout'). When every manager is done, email CISO_EMAIL one summary.",
 "apis": [
  "iam.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "Cron",
  "must_have_types": [
   "Postgres",
   "Approval",
   "SendEmail"
  ],
  "must_call": [
   "iam.revoke"
  ],
  "max_nodes": 30
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "One manager revokes one user, the other keeps everyone",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$pgr:user_access": {
     "items": [
      {
       "rows": [
        {
         "user_id": "u1",
         "user_email": "u1@bank.test",
         "system": "core",
         "manager_email": "m1@bank.test"
        },
        {
         "user_id": "u4",
         "user_email": "u4@bank.test",
         "system": "swift",
         "manager_email": "m2@bank.test"
        },
        {
         "user_id": "u2",
         "user_email": "u2@bank.test",
         "system": "core",
         "manager_email": "m1@bank.test"
        },
        {
         "user_id": "u3",
         "user_email": "u3@bank.test",
         "system": "crm",
         "manager_email": "m1@bank.test"
        }
       ],
       "rowCount": 4
      }
     ]
    },
    "$nth:Approval::1": {
     "approval": {
      "decision": "{{ 'approved' if 'm1@' in json_stringify($json) else 'approved' }}",
      "comment": "",
      "form_data": {
       "revoke": "{{ 'u3' if 'm1@' in json_stringify($json) else '' }}"
      },
      "decided_by": "test"
     }
    },
    "$nth:Approval::2?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$api:iam.revoke": {
     "http": {
      "status": 200,
      "body": {
       "user_id": "x"
      }
     }
    },
    "$pgw:audit_log": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "$all:SendEmail": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "$pgr:audit_log?": {
     "items": [
      {
       "rows": [
        {
         "entity_id": "m1@bank.test",
         "action": "revoked_some",
         "detail": "u3"
        },
        {
         "entity_id": "m2@bank.test",
         "action": "confirmed",
         "detail": ""
        }
       ],
       "rowCount": 2
      }
     ]
    }
   },
   "expect": [
