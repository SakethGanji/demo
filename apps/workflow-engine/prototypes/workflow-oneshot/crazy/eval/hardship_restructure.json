{
 "id": "hardship_restructure",
 "request": "Customers in financial difficulty apply by webhook with loan_id, customer_email and reason. Look the loan up in core banking; if it isn't there, reply 404 {status: 'not_found'} and stop. Otherwise reply 202 {status: 'in_review'} straight away and carry on. A collections officer (task for COLLECTIONS_OFFICER_EMAIL, due in 2 days) assesses it and chooses plan (payment_holiday, term_extension or reduced_payments) and months; they can also reject it. A payment holiday longer than 3 months, or any plan on a loan with more than 50,000 outstanding, also needs the risk manager (RISK_MANAGER_EMAIL, due in 1 day, rejected automatically if nobody decides). Once approved, email the customer the offer (plan and months) and give COLLECTIONS_OFFICER_EMAIL a task, due in 5 days, to record the customer's answer as customer_response (accepted or declined). If there's no answer in 5 days, email the customer a reminder and give the officer the task again, due in 5 more days; if that runs out too, the offer lapses: email the customer and record the plan in ops_db restructure_plans with status 'lapsed'. Accepted: apply it through core banking (restructureLoan with plan and months), and in one ops_db transaction insert the restructure_plans row (loan id, plan, months, status 'active') and an audit_log row (entity 'loan', the loan id, action 'restructured'); then email the customer a confirmation. Declined by the customer or rejected by the officer or risk manager: email the customer, and record the plan with status 'declined'.",
 "apis": [
  "accounts.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "Webhook",
  "must_have_types": [
   "Approval",
   "Postgres",
   "Respond",
   "SendEmail"
  ],
  "must_call": [
   "accounts.restructureLoan"
  ],
  "max_nodes": 40,
  "min_types": {
   "Approval": 4
  }
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Unknown loan: 404 and nothing else",
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L3",
       "customer_email": "jo@mail.test",
       "reason": "lost my job"
      },
      "headers": {},
      "query": {},
      "method": "POST"
     }
    ]
   },
   "mocks": {
    "$pg:loans": {
     "items": [
      {
       "rows": [],
       "rowCount": 0
      }
     ]
    },
    "$nth:Approval:COLLECTIONS_OFFICER_EMAIL:1": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "plan": "payment_holiday",
       "months": 3
      },
      "decided_by": "test"
     }
    },
    "$has:Approval:RISK_MANAGER_EMAIL?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$nth:Approval:COLLECTIONS_OFFICER_EMAIL:2?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "customer_response": "accepted"
      },
      "decided_by": "test"
     }
    },
    "$nth:Approval:COLLECTIONS_OFFICER_EMAIL:3?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "customer_response": "accepted"
      },
      "decided_by": "test"
     }
    },
    "$api:accounts.restructureLoan?": {
     "http": {
      "status": 200,
      "body": {
       "loan_id": "L3",
       "status": "restructured"
      }
     }
    },
    "$pgw:restructure_plans?": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "$all:SendEmail?": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$all:Respond",
     "subject": "request",
     "item": "any",
     "path": "statusCode",
     "op": "eq",
     "value": 404
    },
    {
     "node": "$all:Respond",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$all:Approval",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
