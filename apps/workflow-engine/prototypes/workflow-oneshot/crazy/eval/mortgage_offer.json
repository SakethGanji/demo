      "comment": "",
      "form_data": {
       "approved_amount": 400000,
       "conditions": "valuation required"
      },
      "decided_by": "test"
     }
    },
    "$has:Approval:HEAD_OF_LENDING_EMAIL?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "approved_amount": 400000,
       "conditions": "valuation required"
