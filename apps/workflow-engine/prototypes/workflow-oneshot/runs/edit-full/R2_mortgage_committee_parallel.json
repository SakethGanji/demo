 "tests": [
  {
   "name": "Score 579 is declined",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "application_id": "A1",
       "applicant_email": "a@x.test",
       "amount": 300000,
       "property_value": 400000
      }
     }
    ]
   },
   "mocks": {
    "Get credit score": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "A1",
       "score": 579
      }
     }
    },
    "Email decline": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "Mark declined": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Underwriter decision",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Email decline",
     "subject": "request",
     "path": "params.toEmail",
     "op": "eq",
     "value": "a@x.test"
    },
    {
     "node": "Mark declined",
     "subject": "request",
     "path": "params.statements.0.params.0",
     "op": "eq",
     "value": "declined"
    },
    {
     "node": "Send for signature",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Score 580 and exactly 500000 books without committee",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "application_id": "A2",
       "applicant_email": "b@x.test",
       "amount": 500000,
       "property_value": 700000
      }
     }
    ]
   },
   "mocks": {
    "Get credit score": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "A2",
       "score": 580
      }
     }
    },
    "Underwriter decision": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "approved_amount": 500000,
       "conditions": "Valuation"
      },
      "decided_by": "test"
     }
    },
    "Email offer": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "Send for signature": {
     "http": {
      "status": 200,
      "body": {
       "envelope_id": "env1"
      }
     }
    },
