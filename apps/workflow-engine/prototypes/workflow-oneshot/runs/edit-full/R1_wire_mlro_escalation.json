    },
    "four_eyes": true,
    "notify_email": "{{ $vars.TREASURY_EMAIL }}"
   },
   "position": {
    "x": 190,
    "y": 580
   }
  },
  {
   "name": "Hold wire treasury",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "wires",
     "operation_id": "hold"
    },
    "method": "POST",
    "url": "",
    "path_params": {
     "wire_id": "{{ $node[\"Wire received\"].json.body.wire_id }}"
    },
    "body": {
     "reason": "Rejected by treasury"
    }
   },
   "position": {
    "x": 380,
    "y": 690
   }
  },
