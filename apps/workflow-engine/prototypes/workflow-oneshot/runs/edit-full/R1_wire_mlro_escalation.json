   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('wire', %s, 'held_by_treasury', %s)",
      "params": [
       "{{ $node[\"Wire received\"].json.body.wire_id }}",
       "Rejected by treasury"
      ]
     }
    ]
   },
   "position": {
    "x": 570,
    "y": 690
   }
  },
  {
   "name": "Release wire",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "wires",
     "operation_id": "release"
    },
    "method": "POST",
    "url": "",
    "path_params": {
     "wire_id": "{{ $node[\"Wire received\"].json.body.wire_id }}"
    }
   },
   "position": {
    "x": 380,
    "y": 580
   }
  },
  {
   "name": "Audit released",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
