      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('wire', %s, 'released', %s)",
      "params": [
       "{{ $node[\"Wire received\"].json.body.wire_id }}",
       "Wire released"
      ]
     }
    ]
   },
   "position": {
    "x": 570,
    "y": 580
   }
  }
