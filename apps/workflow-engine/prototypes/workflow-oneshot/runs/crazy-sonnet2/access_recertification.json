{
 "name": "Quarterly access recertification",
 "nodes": [
  {
   "name": "Quarter start",
   "type": "Cron",
   "parameters": {
    "mode": "cron",
    "cronExpression": "0 6 1 1,4,7,10 *"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Read access",
   "type": "Postgres",
   "parameters": {
    "connection": "iam_db",
    "operation": "query",
    "query": "SELECT user_id, user_email, system, manager_email FROM user_access ORDER BY manager_email, user_id",
    "queryParameters": []
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Group by manager",
   "type": "Code",
   "parameters": {
    "code": "groups = {}\norder = []\nfor r in json_data[\"rows\"]:\n    m = r[\"manager_email\"]\n    if m not in groups:\n        groups[m] = []\n        order.append(m)\n    groups[m].append({\"user_id\": r[\"user_id\"], \"system\": r[\"system\"]})\nout = []\nfor m in order:\n    us = groups[m]\n    parts = []\n    for u in us:\n        parts.append(u[\"user_id\"] + \" (\" + u[\"system\"] + \")\")\n    out.append(new_item({\"manager_email\": m, \"users\": us, \"listing\": \"; \".join(parts)}))\nreturn out"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Each manager",
   "type": "Loop",
   "parameters": {
    "batchSize": 1
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Manager task",
   "type": "Approval",
   "parameters": {
    "title": "Access recertification for {{ $node[\"Each manager\"].json.manager_email }}",
    "context": {
     "Manager": "{{ $node[\"Each manager\"].json.manager_email }}",
     "Your people and their systems": "{{ $node[\"Each manager\"].json.listing }}"
    },
    "form": [
     {
      "name": "revoke",
      "label": "User ids to revoke (comma-separated, empty keeps everyone)",
      "type": "text",
      "required": false
     }
    ],
    "due_in": "7d",
    "on_timeout": "timed_out",
    "notify_email": "{{ $node[\"Each manager\"].json.manager_email }}"
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Send reminder",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each manager\"].json.manager_email }}",
    "subject": "Reminder: access recertification is waiting for you",
    "bodyFormat": "plain",
    "body": "You have not yet answered your quarterly access recertification. A new task has been sent to you and is due in 3 days. If it also goes unanswered, access for all your users will be revoked."
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Second task",
   "type": "Approval",
   "parameters": {
    "title": "Final reminder: access recertification for {{ $node[\"Each manager\"].json.manager_email }}",
    "context": {
     "Manager": "{{ $node[\"Each manager\"].json.manager_email }}",
     "Your people and their systems": "{{ $node[\"Each manager\"].json.listing }}"
    },
    "form": [
     {
      "name": "revoke",
      "label": "User ids to revoke (comma-separated, empty keeps everyone)",
      "type": "text",
      "required": false
     }
    ],
    "due_in": "3d",
    "on_timeout": "timed_out",
    "notify_email": "{{ $node[\"Each manager\"].json.manager_email }}"
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Email CISO timeout",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.CISO_EMAIL }}",
    "subject": "Recertification timed out: {{ $node[\"Each manager\"].json.manager_email }}",
    "bodyFormat": "plain",
    "body": "Manager {{ $node[\"Each manager\"].json.manager_email }} did not answer two recertification tasks. Access for all of their users is being revoked: {{ $node[\"Each manager\"].json.listing }}"
   },
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Decide",
   "type": "Code",
   "parameters": {
    "code": "m = node_data[\"Each manager\"][\"json\"]\nusers = m[\"users\"]\nappr = json_data.get(\"approval\")\nids = []\nif appr is None:\n    for u in users:\n        ids.append(u[\"user_id\"])\n    action = \"revoked_all_timeout\"\n    reason = \"Quarterly recertification: manager did not respond\"\nelse:\n    fd = appr.get(\"form_data\") or {}\n    text = fd.get(\"revoke\") or \"\"\n    valid = []\n    for u in users:\n        valid.append(u[\"user_id\"])\n    for x in text.split(\",\"):\n        x = x.strip()\n        if x != \"\" and x in valid and x not in ids:\n            ids.append(x)\n    action = \"revoked_some\" if len(ids) > 0 else \"confirmed\"\n    reason = \"Quarterly recertification: revoked by manager\"\nlst = []\nfor i in ids:\n    lst.append({\"user_id\": i, \"reason\": reason})\nreturn [new_item({\"manager_email\": m[\"manager_email\"], \"action\": action, \"revoke_list\": lst, \"revoke_count\": len(ids), \"detail\": \"revoked: \" + \", \".join(ids)})]"
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Anyone to revoke?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.revoke_count > 0 }}"
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Split users",
   "type": "ItemLists",
   "parameters": {
    "operation": "splitOut",
    "arrayField": "revoke_list",
    "includeOther": false
   },
   "position": {
    "x": 570,
    "y": 290
   }
  },
  {
   "name": "Revoke access",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "iam",
     "operation_id": "revoke"
    },
    "method": "POST",
    "url": "",
    "path_params": {
     "user_id": "{{ $json.user_id }}"
    },
    "body": {
     "reason": "{{ $json.reason }}"
    }
   },
   "position": {
    "x": 760,
    "y": 290
   }
  },
  {
   "name": "Count revoked",
   "type": "ItemLists",
   "parameters": {
    "operation": "summarize"
   },
   "position": {
    "x": 950,
    "y": 290
   }
  },
  {
   "name": "Record outcome",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('recert', %s, %s, %s)",
      "params": [
       "{{ $node[\"Decide\"].json.manager_email }}",
       "{{ $node[\"Decide\"].json.action }}",
       "{{ $node[\"Decide\"].json.detail }}"
      ]
     }
    ]
   },
   "position": {
    "x": 1140,
    "y": 290
   }
  },
  {
   "name": "Read outcomes",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "query",
    "query": "SELECT entity_id, action, detail FROM audit_log WHERE entity = 'recert' AND created_at > now() - interval '14 days' ORDER BY id",
    "queryParameters": []
   },
   "position": {
    "x": 760,
    "y": 110
   }
  },
  {
   "name": "Build summary",
   "type": "Code",
   "parameters": {
    "code": "lines = []\nfor r in json_data[\"rows\"]:\n    lines.append(r[\"entity_id\"] + \": \" + r[\"action\"] + \" (\" + str(r[\"detail\"]) + \")\")\nreturn [new_item({\"body\": \"Quarterly access recertification finished. Managers: \" + str(len(lines)) + \"\\n\" + \"\\n\".join(lines)})]"
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Email summary",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.CISO_EMAIL }}",
    "subject": "Quarterly access recertification summary",
    "bodyFormat": "plain",
    "body": "{{ $json.body }}"
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  }
 ],
