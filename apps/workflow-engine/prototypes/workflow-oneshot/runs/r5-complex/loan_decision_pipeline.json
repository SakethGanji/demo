     "op": "eq",
     "value": "L4"
    }
   ]
  },
  {
   "name": "High-score mortgage always goes to an underwriter and is declined when rejected",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "applicant_id": "A5",
       "product": "mortgage",
       "amount": 300000,
       "income": 150000
      }
     }
    ]
   },
   "mocks": {
    "Credit check": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "A5",
       "score": 800
      }
     }
    },
    "Fraud check": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "A5",
       "flagged": false
      }
     }
    },
    "Summarise application": {
     "items": [
      {
       "response": "",
       "structured": {
        "summary": "Strong mortgage applicant."
       }
      }
     ]
    },
    "Underwriter review": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "Debt too high",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "Decline by underwriter": {
     "http": {
      "status": 200,
      "body": {
       "decline_id": "D5"
      }
     }
    }
   },
   "expect": [
    {
     "node": "Underwriter review",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "Book loan",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Decline by underwriter",
     "subject": "request",
     "path": "body.reason",
