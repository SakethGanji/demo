    },
    {
     "node": "Reply approved",
     "subject": "request",
     "path": "body.decision",
     "op": "eq",
     "value": "approved"
    }
   ]
  },
  {
   "name": "Score 720 personal loan is booked automatically",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "applicant_id": "A4",
       "product": "personal",
       "amount": 20000,
       "income": 90000
      }
     }
    ]
   },
   "mocks": {
    "Credit check": {
     "http": {
      "status": 200,
      "body": {
