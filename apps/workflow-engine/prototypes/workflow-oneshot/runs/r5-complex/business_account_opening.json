{
 "name": "Business account application",
 "nodes": [
  {
   "name": "Application received",
   "type": "Webhook",
   "parameters": {
    "method": "POST",
    "path": "business-account-application",
    "responseMode": "lastNode"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Verify director",
   "type": "ExecuteWorkflow",
   "parameters": {
    "workflowId": "wf_kyc_verify",
    "version": "latest",
    "inputMode": "map",
    "inputs": {
     "customer_id": "{{ $json.body.director_customer_id }}",
     "document_id": "{{ $json.body.director_document_id }}"
    }
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Verified?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.verified == true }}"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Record declined ID",
   "type": "DataTable",
   "parameters": {
    "table": "business_applications",
    "operation": "insert",
    "data": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "status": "declined"
    }
   },
   "position": {
    "x": 570,
    "y": 110
   }
  },
  {
   "name": "Reply declined ID",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "declined",
     "message": "Director identity could not be verified"
    }
   },
   "position": {
    "x": 760,
    "y": 110
   }
  },
  {
   "name": "Screen sanctions",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "screening",
     "operation_id": "screen"
    },
    "method": "POST",
    "url": "",
    "body": {
     "name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "country": "{{ $node[\"Application received\"].json.body.country }}"
    }
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Sanctions hit?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.body.hit == true }}"
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Open compliance case",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "compliance",
     "operation_id": "openCase"
    },
    "method": "POST",
    "url": "",
    "body": {
     "subject": "{{ $node[\"Application received\"].json.body.company_name }}",
     "reason": "Sanctions screening hit on business account application"
    }
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Record declined sanctions",
   "type": "DataTable",
   "parameters": {
    "table": "business_applications",
    "operation": "insert",
    "data": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "status": "declined"
    }
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Reply declined sanctions",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "declined",
     "message": "Application declined after sanctions screening"
    }
   },
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Get rating",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "bizbureau",
     "operation_id": "companyRating"
    },
    "method": "POST",
    "url": "",
    "body": {
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}"
    }
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Work out risk",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "rating",
      "value": "{{ $json.body.rating }}"
     },
     {
      "name": "risk",
      "value": "{{ 'high' if ($json.body.rating == 'D' or float($node[\"Application received\"].json.body.expected_monthly_volume) > 5000000) else ('low' if (($json.body.rating == 'A' or $json.body.rating == 'B') and float($node[\"Application received\"].json.body.expected_monthly_volume) <= 1000000) else 'medium') }}"
     }
    ]
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  },
  {
   "name": "Low risk?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.risk == 'low' }}"
   },
   "position": {
    "x": 0,
    "y": 400
   }
  },
  {
   "name": "AI risk note",
   "type": "AIAgent",
   "parameters": {
    "systemPrompt": "You write short risk notes for bank compliance staff. Two sentences at most, plain facts only.",
    "task": "Write a short risk note for this business account application. Company: {{ $node[\"Application received\"].json.body.company_name }}. Country: {{ $node[\"Application received\"].json.body.country }}. Credit rating: {{ $json.rating }}. Expected monthly volume: {{ $node[\"Application received\"].json.body.expected_monthly_volume }}. Risk level: {{ $json.risk }}.",
    "outputSchema": {
     "type": "object",
     "properties": {
      "note": {
       "type": "string"
      }
     },
     "required": [
      "note"
     ]
    }
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Compliance officer",
   "type": "Approval",
   "parameters": {
    "title": "Business account: {{ $node[\"Application received\"].json.body.company_name }} ({{ $node[\"Work out risk\"].json.risk }} risk)",
    "context": {
     "Company": "{{ $node[\"Application received\"].json.body.company_name }}",
     "Registration number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "Country": "{{ $node[\"Application received\"].json.body.country }}",
     "Expected monthly volume": "{{ $node[\"Application received\"].json.body.expected_monthly_volume }}",
     "Credit rating": "{{ $node[\"Work out risk\"].json.rating }}",
     "Risk": "{{ $node[\"Work out risk\"].json.risk }}",
     "Risk note": "{{ $node[\"AI risk note\"].json.structured.note }}"
    },
    "notify_email": "{{ $vars.COMPLIANCE_EMAIL }}",
    "four_eyes": true,
    "require_comment_on_reject": true
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Needs head?",
   "type": "If",
   "parameters": {
    "condition": "{{ $node[\"Work out risk\"].json.risk == 'high' }}"
   },
   "position": {
    "x": 570,
    "y": 290
   }
  },
  {
   "name": "Head of compliance",
   "type": "Approval",
   "parameters": {
    "title": "High risk business account: {{ $node[\"Application received\"].json.body.company_name }}",
    "context": {
     "Company": "{{ $node[\"Application received\"].json.body.company_name }}",
     "Registration number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "Country": "{{ $node[\"Application received\"].json.body.country }}",
     "Expected monthly volume": "{{ $node[\"Application received\"].json.body.expected_monthly_volume }}",
     "Credit rating": "{{ $node[\"Work out risk\"].json.rating }}",
     "Risk": "{{ $node[\"Work out risk\"].json.risk }}",
     "Risk note": "{{ $node[\"AI risk note\"].json.structured.note }}",
     "Officer comment": "{{ $node[\"Compliance officer\"].json.approval.comment }}"
    },
    "notify_email": "{{ $vars.HEAD_OF_COMPLIANCE_EMAIL }}",
    "four_eyes": true,
    "require_comment_on_reject": true
   },
   "position": {
    "x": 760,
    "y": 290
   }
  },
  {
   "name": "Record rejected",
   "type": "DataTable",
   "parameters": {
    "table": "business_applications",
    "operation": "insert",
    "data": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "risk": "{{ $node[\"Work out risk\"].json.risk }}",
     "status": "rejected"
    }
   },
   "position": {
    "x": 950,
    "y": 400
   }
  },
  {
   "name": "Reply rejected",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "rejected",
     "message": "Application rejected by compliance"
    }
   },
   "position": {
    "x": 1140,
    "y": 510
   }
  },
  {
   "name": "Open account",
   "type": "HttpRequest",
   "on_error": "error_output",
   "parameters": {
    "api_ref": {
     "spec_id": "accounts",
     "operation_id": "openBusiness"
    },
    "method": "POST",
    "url": "",
    "body": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}"
    }
   },
   "position": {
    "x": 950,
    "y": 290
   }
  },
  {
   "name": "Record opened",
   "type": "DataTable",
   "parameters": {
    "table": "business_applications",
    "operation": "insert",
    "data": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "risk": "{{ $node[\"Work out risk\"].json.risk }}",
     "status": "opened"
    }
   },
   "position": {
    "x": 1140,
    "y": 290
   }
  },
  {
   "name": "Email contact",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Application received\"].json.body.contact_email }}",
    "subject": "Your business account is open",
    "bodyFormat": "plain",
    "body": "Your business account for {{ $node[\"Application received\"].json.body.company_name }} is now open. Account number: {{ $node[\"Open account\"].json.body.account_number }}"
   },
   "position": {
    "x": 0,
    "y": 690
   }
  },
  {
   "name": "Reply opened",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "opened",
     "account_number": "{{ $node[\"Open account\"].json.body.account_number }}"
    }
   },
   "position": {
    "x": 190,
    "y": 690
   }
  },
  {
   "name": "Record failed",
   "type": "DataTable",
   "parameters": {
    "table": "business_applications",
    "operation": "insert",
    "data": {
     "company_name": "{{ $node[\"Application received\"].json.body.company_name }}",
     "registration_number": "{{ $node[\"Application received\"].json.body.registration_number }}",
     "risk": "{{ $node[\"Work out risk\"].json.risk }}",
     "status": "failed"
    }
   },
   "position": {
    "x": 1140,
    "y": 400
   }
  },
  {
   "name": "Reply failed",
   "type": "Respond",
   "parameters": {
    "statusCode": 500,
    "body": {
     "status": "error",
     "message": "The account could not be opened"
    }
   },
   "position": {
    "x": 0,
    "y": 800
   }
  }
 ],
