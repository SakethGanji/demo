 "tests": [
  {
   "name": "Low risk at exactly 1,000,000 opens automatically",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "company_name": "Acme Ltd",
       "registration_number": "REG1",
       "country": "GB",
       "director_customer_id": "c1",
       "director_document_id": "d1",
       "expected_monthly_volume": 1000000,
       "contact_email": "cfo@acme.test"
      }
     }
    ]
   },
   "mocks": {
    "Verify director": {
     "items": [
      {
       "verified": true,
       "reason": ""
      }
     ]
    },
    "Screen sanctions": {
     "http": {
      "status": 200,
      "body": {
       "hit": false,
       "list": ""
      }
     }
    },
    "Get rating": {
     "http": {
      "status": 200,
      "body": {
       "registration_number": "REG1",
       "rating": "B"
      }
     }
    },
    "Open account": {
     "http": {
      "status": 200,
      "body": {
       "account_number": "BA-1001"
      }
     }
    },
    "Record opened": {
     "items": [
      {
       "id": "1"
      }
     ]
    },
    "Email contact": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Work out risk",
     "path": "risk",
     "op": "eq",
     "value": "low"
    },
    {
     "node": "Compliance officer",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Open account",
     "subject": "request",
     "path": "body.company_name",
     "op": "eq",
     "value": "Acme Ltd"
    },
    {
     "node": "Record opened",
     "subject": "request",
     "path": "params.data.status",
     "op": "eq",
     "value": "opened"
    },
    {
     "node": "Record opened",
     "subject": "request",
     "path": "params.data.risk",
     "op": "eq",
     "value": "low"
    },
    {
     "node": "Email contact",
     "subject": "request",
     "path": "params.toEmail",
     "op": "eq",
     "value": "cfo@acme.test"
    },
    {
     "node": "Email contact",
     "subject": "request",
     "path": "params.body",
     "op": "contains",
     "value": "BA-1001"
    },
    {
     "node": "Reply opened",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "opened"
    }
   ]
  },
  {
   "name": "Unverified director is declined and nothing else runs",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "company_name": "Acme Ltd",
       "registration_number": "REG1",
       "country": "GB",
       "director_customer_id": "c1",
       "director_document_id": "d1",
       "expected_monthly_volume": 1000,
       "contact_email": "cfo@acme.test"
      }
     }
    ]
   },
   "mocks": {
    "Verify director": {
     "items": [
      {
       "verified": false,
       "reason": "document mismatch"
      }
     ]
    },
    "Record declined ID": {
     "items": [
      {
       "id": "1"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Screen sanctions",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Open account",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record declined ID",
     "subject": "request",
     "path": "params.data.status",
     "op": "eq",
     "value": "declined"
    },
    {
     "node": "Reply declined ID",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "declined"
    }
   ]
  },
  {
   "name": "Sanctions hit opens a compliance case naming the company and declines",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "company_name": "Blocked Trading",
       "registration_number": "REG2",
       "country": "XX",
       "director_customer_id": "c2",
       "director_document_id": "d2",
       "expected_monthly_volume": 50000,
       "contact_email": "info@blocked.test"
      }
     }
    ]
   },
   "mocks": {
    "Verify director": {
     "items": [
      {
       "verified": true,
