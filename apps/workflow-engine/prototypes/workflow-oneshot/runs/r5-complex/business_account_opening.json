     ]
    },
    "Screen sanctions": {
     "http": {
      "status": 200,
      "body": {
       "hit": true,
       "list": "OFAC"
      }
     }
    },
    "Open compliance case": {
     "http": {
      "status": 200,
      "body": {
       "case_id": "CASE-1"
      }
     }
    },
    "Record declined sanctions": {
     "items": [
      {
       "id": "2"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Open compliance case",
     "subject": "request",
     "path": "body.subject",
     "op": "eq",
     "value": "Blocked Trading"
    },
    {
     "node": "Get rating",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Open account",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record declined sanctions",
     "subject": "request",
     "path": "params.data.status",
     "op": "eq",
     "value": "declined"
    },
    {
     "node": "Reply declined sanctions",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "declined"
    }
   ]
  },
  {
   "name": "High risk needs the officer and then the head of compliance",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "company_name": "Big Co",
       "registration_number": "REG3",
       "country": "DE",
       "director_customer_id": "c3",
       "director_document_id": "d3",
       "expected_monthly_volume": 6000000,
       "contact_email": "fin@bigco.test"
      }
     }
    ]
   },
   "mocks": {
    "Verify director": {
     "items": [
      {
       "verified": true,
       "reason": ""
      }
     ]
    },
    "Screen sanctions": {
     "http": {
      "status": 200,
      "body": {
       "hit": false,
       "list": ""
      }
     }
    },
    "Get rating": {
     "http": {
      "status": 200,
      "body": {
       "registration_number": "REG3",
       "rating": "B"
      }
     }
    },
    "AI risk note": {
     "items": [
      {
       "response": "",
       "structured": {
        "note": "Very high volume for a B-rated company."
       }
      }
     ]
