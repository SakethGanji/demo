    "items": [
     {}
    ]
   },
   "mocks": {
    "Get flagged": {
     "http": {
      "status": 200,
      "body": {
       "transactions": [
        {
         "txn_id": "t1",
         "card_id": "c1",
         "customer_phone": "+100",
         "score": 20
        },
        {
         "txn_id": "t2",
         "card_id": "c2",
         "customer_phone": "+200",
         "score": 55
        },
        {
         "txn_id": "t3",
         "card_id": "c3",
         "customer_phone": "+300",
         "score": 90
        }
       ]
      }
     }
    },
    "Clear transaction": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "t1",
       "status": "cleared"
      }
     }
    },
    "Freeze card medium": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "c2",
       "status": "frozen"
      }
     }
    },
    "Text customer": {
     "http": {
      "status": 200,
      "body": {
       "sent": true
      }
     }
    },
    "Freeze card high": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "c3",
       "status": "frozen"
      }
     }
    },
    "Block card": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "c3",
       "status": "blocked"
      }
     }
    },
    "Open fraud case": {
     "http": {
      "status": 200,
      "body": {
       "case_id": "case1"
      }
     }
    },
    "Email fraud team": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Clear transaction",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Freeze card medium",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Text customer",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Freeze card high",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Block card",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Open fraud case",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Email fraud team",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Email fraud team",
     "subject": "request",
     "path": "params.body",
     "op": "contains",
     "value": "2 cards"
    }
   ]
  },
