{
 "name": "Daily KYC document chase",
 "nodes": [
  {
   "name": "Every day 8am",
   "type": "Cron",
   "parameters": {
    "mode": "cron",
    "cronExpression": "0 8 * * *"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Get open requests",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "query",
    "query": "SELECT id, customer_id, email, requested_on, COALESCE(reminders_sent, 0) AS reminders_sent, status, (CURRENT_DATE - requested_on) AS days_open FROM kyc_requests WHERE status IN ('open', 'restricted') ORDER BY id",
    "queryParameters": []
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Split requests",
   "type": "ItemLists",
   "parameters": {
    "operation": "splitOut",
    "arrayField": "rows",
    "includeOther": false
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Each request",
   "type": "Loop",
   "parameters": {
    "batchSize": 1
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Check documents",
   "type": "HttpRequest",
   "parameters": {
    "method": "GET",
    "url": "",
    "api_ref": {
     "spec_id": "dms",
     "operation_id": "documents"
    },
    "path_params": {
     "customer_id": "{{ $node[\"Each request\"].json.customer_id }}"
    }
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Documents uploaded?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.body.uploaded }}"
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Was restricted?",
   "type": "If",
   "parameters": {
    "condition": "{{ $node[\"Each request\"].json.status == 'restricted' }}"
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Lift restriction",
   "type": "HttpRequest",
   "parameters": {
    "method": "POST",
    "url": "",
    "api_ref": {
     "spec_id": "accounts",
     "operation_id": "liftRestriction"
    },
    "path_params": {
     "customer_id": "{{ $node[\"Each request\"].json.customer_id }}"
    }
   },
   "position": {
    "x": 0,
    "y": 400
   }
  },
  {
   "name": "Mark complete",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "UPDATE kyc_requests SET status = 'complete' WHERE id = %s",
      "params": [
       "{{ $node[\"Each request\"].json.id }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('kyc_request', %s, 'completed', %s)",
      "params": [
       "{{ $node[\"Each request\"].json.customer_id }}",
       "Documents received after {{ $node[\"Each request\"].json.days_open }} days"
      ]
     }
    ]
   },
   "position": {
    "x": 190,
    "y": 400
   }
  },
  {
   "name": "Thank customer",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each request\"].json.email }}",
    "subject": "Thank you for your documents",
    "bodyFormat": "plain",
    "body": "Thank you. We have received your KYC documents and your request is now complete."
   },
   "position": {
    "x": 380,
    "y": 400
   }
  },
  {
   "name": "Day 10 and 2 reminders?",
   "type": "If",
   "parameters": {
    "condition": "{{ int($node[\"Each request\"].json.days_open) >= 10 and int($node[\"Each request\"].json.reminders_sent) == 2 and $node[\"Each request\"].json.status == 'open' }}"
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  },
  {
   "name": "Day 7 and 1 reminder?",
   "type": "If",
   "parameters": {
    "condition": "{{ int($node[\"Each request\"].json.days_open) >= 7 and int($node[\"Each request\"].json.reminders_sent) == 1 }}"
   },
   "position": {
    "x": 0,
    "y": 620
   }
  },
  {
   "name": "Day 3 and no reminder?",
   "type": "If",
   "parameters": {
    "condition": "{{ int($node[\"Each request\"].json.days_open) >= 3 and int($node[\"Each request\"].json.reminders_sent) == 0 }}"
   },
   "position": {
    "x": 190,
    "y": 730
   }
  },
  {
   "name": "Restrict customer",
   "type": "HttpRequest",
   "parameters": {
    "method": "POST",
    "url": "",
    "api_ref": {
     "spec_id": "accounts",
     "operation_id": "restrictCustomer"
    },
    "path_params": {
     "customer_id": "{{ $node[\"Each request\"].json.customer_id }}"
    }
   },
   "position": {
    "x": 0,
    "y": 510
   }
  },
  {
   "name": "Mark restricted",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "UPDATE kyc_requests SET status = 'restricted' WHERE id = %s",
      "params": [
       "{{ $node[\"Each request\"].json.id }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('kyc_request', %s, 'restricted', %s)",
      "params": [
       "{{ $node[\"Each request\"].json.customer_id }}",
       "Restricted after {{ $node[\"Each request\"].json.days_open }} days without documents"
      ]
     }
    ]
   },
   "position": {
    "x": 190,
    "y": 510
   }
  },
  {
   "name": "Tell customer restricted",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each request\"].json.email }}",
    "subject": "Your accounts are restricted",
    "bodyFormat": "plain",
    "body": "We have not received your KYC documents, so your accounts are now restricted. Please upload them as soon as possible to have the restriction lifted."
   },
   "position": {
    "x": 380,
    "y": 510
   }
  },
  {
   "name": "Email RM to call",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.RM_EMAIL }}",
    "subject": "Please call customer {{ $node[\"Each request\"].json.customer_id }}",
    "bodyFormat": "plain",
    "body": "Customer {{ $node[\"Each request\"].json.customer_id }} ({{ $node[\"Each request\"].json.email }}) has not provided KYC documents after {{ $node[\"Each request\"].json.days_open }} days and has been restricted. Please call them."
   },
   "position": {
    "x": 570,
    "y": 510
   }
  },
  {
   "name": "Email second reminder",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each request\"].json.email }}",
    "subject": "Second reminder: KYC documents needed",
    "bodyFormat": "plain",
    "body": "This is our second reminder. Please upload your KYC documents soon. Your accounts may be restricted if we do not receive them."
   },
   "position": {
    "x": 190,
    "y": 620
   }
  },
  {
   "name": "Mark second reminder",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "UPDATE kyc_requests SET reminders_sent = 2 WHERE id = %s",
      "params": [
       "{{ $node[\"Each request\"].json.id }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('kyc_request', %s, 'reminded', %s)",
      "params": [
       "{{ $node[\"Each request\"].json.customer_id }}",
       "Second reminder on day {{ $node[\"Each request\"].json.days_open }}"
      ]
     }
    ]
   },
   "position": {
    "x": 380,
    "y": 620
   }
  },
  {
   "name": "Email first reminder",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each request\"].json.email }}",
    "subject": "Reminder: KYC documents needed",
    "bodyFormat": "plain",
    "body": "We still need your KYC documents. Please upload them at your earliest convenience."
   },
   "position": {
    "x": 380,
    "y": 730
   }
  },
  {
   "name": "Mark first reminder",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "UPDATE kyc_requests SET reminders_sent = 1 WHERE id = %s",
      "params": [
       "{{ $node[\"Each request\"].json.id }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('kyc_request', %s, 'reminded', %s)",
      "params": [
       "{{ $node[\"Each request\"].json.customer_id }}",
       "First reminder on day {{ $node[\"Each request\"].json.days_open }}"
      ]
     }
    ]
   },
   "position": {
    "x": 570,
    "y": 620
   }
  },
  {
   "name": "Count outcomes",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "query",
    "query": "SELECT COUNT(*) FILTER (WHERE action = 'completed') AS completed, COUNT(*) FILTER (WHERE action = 'reminded') AS reminded, COUNT(*) FILTER (WHERE action = 'restricted') AS restricted FROM audit_log WHERE entity = 'kyc_request' AND created_at >= CURRENT_DATE",
    "queryParameters": []
   },
   "position": {
    "x": 760,
    "y": 110
   }
  },
  {
   "name": "Anything happened?",
   "type": "If",
   "parameters": {
    "condition": "{{ int($json.rows[0].completed) + int($json.rows[0].reminded) + int($json.rows[0].restricted) > 0 }}"
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Email KYC team",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.KYC_TEAM_EMAIL }}",
    "subject": "Daily KYC summary",
    "bodyFormat": "plain",
    "body": "KYC requests today: {{ $json.rows[0].completed }} completed, {{ $json.rows[0].reminded }} reminded, {{ $json.rows[0].restricted }} restricted."
   },
   "position": {
    "x": 1140,
    "y": 220
   }
  },
  {
   "name": "Email RM complete",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.RM_EMAIL }}",
    "subject": "KYC complete for customer {{ $node[\"Each request\"].json.customer_id }}",
    "bodyFormat": "plain",
    "body": "Customer {{ $node[\"Each request\"].json.customer_id }} has provided their KYC documents and the request is complete."
   },
   "position": {
    "x": 570,
    "y": 400
   }
  }
 ],
