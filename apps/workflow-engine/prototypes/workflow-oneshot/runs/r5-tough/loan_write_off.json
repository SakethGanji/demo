    },
    {
     "node": "Committee approval 1",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record write-off",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Rejection replies with the comment and writes nothing",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L1",
       "amount": 3000,
       "reason": "uncollectable"
      }
     }
    ]
   },
   "mocks": {
    "Get loan": {
     "items": [
      {
       "rows": [
        {
         "loan_id": "L1",
         "outstanding": "8000",
         "status": "defaulted"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Ops manager approval": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "still collectable",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "rejected"
    },
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": "still collectable"
    },
    {
     "node": "Record write-off",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  }
 ]
