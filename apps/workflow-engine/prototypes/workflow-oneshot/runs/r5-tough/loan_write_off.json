 "tests": [
  {
   "name": "Unknown loan is refused",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L404",
       "amount": 1000,
       "reason": "uncollectable"
      }
     }
    ]
   },
   "mocks": {
    "Get loan": {
     "items": [
      {
       "rows": [],
       "rowCount": 0
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Refuse not found",
     "subject": "request",
     "path": "statusCode",
     "op": "eq",
     "value": 422
    },
    {
     "node": "Refuse not found",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": "loan not found"
    },
    {
     "node": "Ops manager approval",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record write-off",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Loan not defaulted is refused",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L1",
       "amount": 1000,
       "reason": "uncollectable"
      }
     }
    ]
   },
   "mocks": {
    "Get loan": {
     "items": [
      {
       "rows": [
        {
         "loan_id": "L1",
         "outstanding": "10000",
         "status": "active"
        }
       ],
       "rowCount": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Refuse not defaulted",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": "loan not defaulted"
    },
    {
     "node": "Ops manager approval",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Amount above outstanding is refused",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L1",
       "amount": 10001,
       "reason": "uncollectable"
      }
     }
    ]
   },
   "mocks": {
    "Get loan": {
     "items": [
      {
       "rows": [
        {
         "loan_id": "L1",
         "outstanding": "10000",
         "status": "defaulted"
        }
       ],
       "rowCount": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Refuse exceeds",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": "amount exceeds outstanding"
    },
    {
     "node": "Record write-off",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Exactly 5000 needs only the ops manager",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "loan_id": "L1",
       "amount": 5000,
       "reason": "uncollectable"
      }
     }
    ]
   },
   "mocks": {
    "Get loan": {
     "items": [
      {
       "rows": [
        {
         "loan_id": "L1",
         "outstanding": "8000",
         "status": "defaulted"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Ops manager approval": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "ok",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "Record write-off": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Committee approval 1",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record write-off",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "Reply written off",
