{
 "name": "Loan write-off approval",
 "nodes": [
  {
   "name": "Write-off request",
   "type": "Webhook",
   "parameters": {
    "method": "POST",
    "path": "loan-write-offs",
    "responseMode": "lastNode"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Get loan",
   "type": "Postgres",
   "parameters": {
    "connection": "core_banking",
    "operation": "query",
    "query": "SELECT loan_id, outstanding, status FROM loans WHERE loan_id = %s",
    "queryParameters": [
     "{{ $json.body.loan_id }}"
    ]
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Loan found?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.rowCount > 0 }}"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Refuse not found",
   "type": "Respond",
   "parameters": {
    "statusCode": 422,
    "body": {
     "status": "refused",
     "reason": "loan not found"
    }
   },
   "position": {
    "x": 570,
    "y": 110
   }
  },
  {
   "name": "Loan defaulted?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.rows[0].status == 'defaulted' }}"
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Refuse not defaulted",
   "type": "Respond",
   "parameters": {
    "statusCode": 422,
    "body": {
     "status": "refused",
     "reason": "loan not defaulted"
    }
   },
   "position": {
    "x": 760,
    "y": 110
   }
  },
  {
   "name": "Amount within balance?",
   "type": "If",
   "parameters": {
    "condition": "{{ float($node[\"Write-off request\"].json.body.amount) <= float($json.rows[0].outstanding) }}"
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Refuse exceeds",
   "type": "Respond",
   "parameters": {
    "statusCode": 422,
    "body": {
     "status": "refused",
     "reason": "amount exceeds outstanding"
    }
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Up to 5000?",
   "type": "If",
   "parameters": {
    "condition": "{{ float($node[\"Write-off request\"].json.body.amount) <= 5000 }}"
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Up to 50000?",
   "type": "If",
   "parameters": {
    "condition": "{{ float($node[\"Write-off request\"].json.body.amount) <= 50000 }}"
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  },
  {
   "name": "Refuse board",
   "type": "Respond",
   "parameters": {
    "statusCode": 422,
    "body": {
     "status": "refused",
     "reason": "needs board approval"
    }
   },
   "position": {
    "x": 0,
    "y": 400
   }
  },
  {
   "name": "Ops manager approval",
   "type": "Approval",
   "parameters": {
    "title": "Approve write-off of {{ $node[\"Write-off request\"].json.body.amount }} for loan {{ $node[\"Write-off request\"].json.body.loan_id }}",
    "context": {
     "Loan": "{{ $node[\"Write-off request\"].json.body.loan_id }}",
     "Amount": "{{ $node[\"Write-off request\"].json.body.amount }}",
     "Reason": "{{ $node[\"Write-off request\"].json.body.reason }}",
     "Outstanding": "{{ $json.rows[0].outstanding }}"
    },
    "due_in": "2d",
    "on_timeout": "reject",
    "notify_email": "{{ $vars.OPS_MANAGER_EMAIL }}",
    "require_comment_on_reject": true
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Committee approval 1",
   "type": "Approval",
   "parameters": {
    "title": "First approval: write-off of {{ $node[\"Write-off request\"].json.body.amount }} for loan {{ $node[\"Write-off request\"].json.body.loan_id }}",
    "context": {
     "Loan": "{{ $node[\"Write-off request\"].json.body.loan_id }}",
     "Amount": "{{ $node[\"Write-off request\"].json.body.amount }}",
     "Reason": "{{ $node[\"Write-off request\"].json.body.reason }}",
     "Outstanding": "{{ $json.rows[0].outstanding }}"
    },
    "due_in": "2d",
    "on_timeout": "reject",
    "notify_email": "{{ $vars.CREDIT_COMMITTEE_EMAIL }}",
    "require_comment_on_reject": true,
    "four_eyes": true
   },
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Committee approval 2",
   "type": "Approval",
   "parameters": {
    "title": "Second approval: write-off of {{ $node[\"Write-off request\"].json.body.amount }} for loan {{ $node[\"Write-off request\"].json.body.loan_id }}",
    "context": {
     "Loan": "{{ $node[\"Write-off request\"].json.body.loan_id }}",
     "Amount": "{{ $node[\"Write-off request\"].json.body.amount }}",
     "Reason": "{{ $node[\"Write-off request\"].json.body.reason }}",
     "First approver comment": "{{ $json.approval.comment }}"
    },
    "due_in": "2d",
    "on_timeout": "reject",
    "notify_email": "{{ $vars.CREDIT_COMMITTEE_EMAIL }}",
    "require_comment_on_reject": true,
    "four_eyes": true
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Record write-off",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO write_offs (loan_id, amount, approver_comment) VALUES (%s, %s, %s)",
      "params": [
       "{{ $node[\"Write-off request\"].json.body.loan_id }}",
       "{{ $node[\"Write-off request\"].json.body.amount }}",
       "{{ $json.approval.comment }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('loan', %s, 'write_off', %s)",
      "params": [
       "{{ $node[\"Write-off request\"].json.body.loan_id }}",
       "{{ $node[\"Write-off request\"].json.body.reason }}"
      ]
     }
    ]
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Reply written off",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "written_off"
    }
   },
   "position": {
    "x": 570,
    "y": 290
   }
  },
  {
   "name": "Reply rejected",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "rejected",
     "reason": "{{ $json.approval.comment }}"
    }
   },
   "position": {
    "x": 380,
    "y": 400
   }
  }
 ],
