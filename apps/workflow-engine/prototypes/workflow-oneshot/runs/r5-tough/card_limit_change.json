{
 "name": "Card daily limit change",
 "nodes": [
  {
   "name": "Limit request",
   "type": "Webhook",
   "parameters": {
    "method": "POST",
    "path": "card-limit-change",
    "responseMode": "lastNode"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Get card",
   "type": "Postgres",
   "parameters": {
    "connection": "core_banking",
    "operation": "query",
    "query": "SELECT card_id, daily_limit FROM cards WHERE card_id = %s",
    "queryParameters": [
     "{{ $json.body.card_id }}"
    ]
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Card found?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.rowCount > 0 }}"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Reply not found",
   "type": "Respond",
   "parameters": {
    "statusCode": 404,
    "body": {
     "status": "not_found"
    }
   },
   "position": {
    "x": 570,
    "y": 110
   }
  },
  {
   "name": "Gather request",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "card_id",
      "value": "{{ $node[\"Limit request\"].json.body.card_id }}"
     },
     {
      "name": "requested_limit",
      "value": "{{ float($node[\"Limit request\"].json.body.requested_limit) }}"
     },
     {
      "name": "reason",
      "value": "{{ $node[\"Limit request\"].json.body.reason }}"
     },
     {
      "name": "current_limit",
      "value": "{{ float($json.rows[0].daily_limit) }}"
     }
    ]
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Is increase?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.requested_limit > $json.current_limit }}"
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Use requested limit",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "new_limit",
      "value": "{{ $json.requested_limit }}"
     }
    ]
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Credit officer",
   "type": "Approval",
   "parameters": {
    "title": "Card limit increase for {{ $json.card_id }}",
    "context": {
     "Card": "{{ $json.card_id }}",
     "Current limit": "{{ $json.current_limit }}",
     "Requested limit": "{{ $json.requested_limit }}",
     "Reason": "{{ $json.reason }}"
    },
    "form": [
     {
      "name": "approved_limit",
      "label": "Approved limit",
      "type": "number",
      "required": true
     }
    ],
    "require_comment_on_reject": true,
    "due_in": "4h",
    "on_timeout": "timed_out",
    "notify_email": "{{ $vars.CREDIT_OFFICER_EMAIL }}"
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Head of credit",
   "type": "Approval",
   "parameters": {
    "title": "Escalated: card limit increase for {{ $json.card_id }}",
    "context": {
     "Card": "{{ $json.card_id }}",
     "Current limit": "{{ $json.current_limit }}",
     "Requested limit": "{{ $json.requested_limit }}",
     "Reason": "{{ $json.reason }}"
    },
    "form": [
     {
      "name": "approved_limit",
      "label": "Approved limit",
      "type": "number",
      "required": true
     }
    ],
    "require_comment_on_reject": true,
    "due_in": "1d",
    "on_timeout": "reject",
    "notify_email": "{{ $vars.HEAD_OF_CREDIT_EMAIL }}"
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Use approved limit",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "new_limit",
      "value": "{{ $json.approval.form_data.approved_limit }}"
     }
    ]
   },
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Reply rejected",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "rejected",
     "reason": "{{ coalesce($json.approval.comment, \"\") }}"
    }
   },
   "position": {
    "x": 0,
    "y": 400
   }
  },
  {
   "name": "Set limit",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "cards",
     "operation_id": "setLimit"
    },
    "method": "POST",
    "url": "",
    "path_params": {
     "card_id": "{{ $json.card_id }}"
    },
    "body": {
     "daily_limit": "{{ $json.new_limit }}"
    }
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Record change",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO limit_changes (card_id, old_limit, new_limit, reason) VALUES (%s, %s, %s, %s)",
      "params": [
       "{{ $node[\"Limit request\"].json.body.card_id }}",
       "{{ $node[\"Gather request\"].json.current_limit }}",
       "{{ $node[\"Set limit\"].json.body.daily_limit }}",
       "{{ $node[\"Limit request\"].json.body.reason }}"
      ]
     },
     {
      "query": "INSERT INTO audit_log (entity, entity_id, action, detail) VALUES ('card', %s, 'limit_change', %s)",
      "params": [
       "{{ $node[\"Limit request\"].json.body.card_id }}",
       "Limit changed from {{ $node[\"Gather request\"].json.current_limit }} to {{ $node[\"Set limit\"].json.body.daily_limit }}"
      ]
     }
    ]
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Reply applied",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "applied",
     "limit": "{{ $node[\"Set limit\"].json.body.daily_limit }}"
    }
   },
   "position": {
    "x": 570,
    "y": 290
   }
  }
 ],
 "connections": [
