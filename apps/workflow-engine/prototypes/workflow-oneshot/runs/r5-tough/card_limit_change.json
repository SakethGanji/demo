 ],
 "tests": [
  {
   "name": "Unknown card gets 404 and nothing else",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C9",
       "requested_limit": 1000,
       "reason": "travel"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [],
       "rowCount": 0
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Reply not found",
     "subject": "request",
     "path": "statusCode",
     "op": "eq",
     "value": 404
    },
    {
     "node": "Reply not found",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "not_found"
    },
    {
     "node": "Set limit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record change",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Decrease is applied without approval",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C1",
       "requested_limit": 300,
       "reason": "lost phone"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [
        {
         "card_id": "C1",
         "daily_limit": 500
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Set limit": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "C1",
       "daily_limit": 300
      }
     }
    },
    "Record change": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Credit officer",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Set limit",
     "subject": "request",
     "path": "body.daily_limit",
     "op": "eq",
     "value": 300
    },
    {
     "node": "Reply applied",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "applied"
    },
    {
     "node": "Reply applied",
     "subject": "request",
     "path": "body.limit",
     "op": "eq",
     "value": 300
    }
   ]
  },
  {
   "name": "Same limit is applied without approval",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C1",
       "requested_limit": 500,
       "reason": "no change"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [
        {
         "card_id": "C1",
         "daily_limit": 500
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Set limit": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "C1",
       "daily_limit": 500
      }
     }
    },
    "Record change": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Credit officer",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Set limit",
     "subject": "request",
     "path": "body.daily_limit",
     "op": "eq",
     "value": 500
    },
    {
     "node": "Reply applied",
     "subject": "request",
     "path": "body.limit",
     "op": "eq",
     "value": 500
    }
   ]
  },
  {
   "name": "Increase approved at a lower limit uses the approved limit",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C1",
       "requested_limit": 1000,
       "reason": "holiday"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [
        {
         "card_id": "C1",
         "daily_limit": 500
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Credit officer": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "approved_limit": 800
      },
      "decided_by": "test"
     }
    },
    "Set limit": {
     "http": {
      "status": 200,
      "body": {
       "card_id": "C1",
       "daily_limit": 800
      }
     }
    },
    "Record change": {
     "items": [
      {
       "success": true
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Set limit",
     "subject": "request",
     "path": "body.daily_limit",
     "op": "eq",
     "value": 800
    },
    {
     "node": "Record change",
     "subject": "request",
     "path": "params.statements",
     "op": "exists"
    },
    {
     "node": "Head of credit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Reply applied",
     "subject": "request",
     "path": "body.limit",
     "op": "eq",
     "value": 800
    }
   ]
  },
  {
   "name": "Credit officer rejects with a reason",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C1",
       "requested_limit": 1000,
       "reason": "holiday"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [
        {
         "card_id": "C1",
         "daily_limit": 500
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Credit officer": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "too risky",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "rejected"
    },
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": "too risky"
    },
    {
     "node": "Set limit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record change",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Nobody decides in time: rejected with empty reason",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "body": {
       "card_id": "C1",
       "requested_limit": 1000,
       "reason": "holiday"
      }
     }
    ]
   },
   "mocks": {
    "Get card": {
     "items": [
      {
       "rows": [
        {
         "card_id": "C1",
         "daily_limit": 500
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Credit officer": {
     "port": "timed_out",
     "approval": {
      "decision": "timed_out",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "Head of credit": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "Head of credit",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.status",
     "op": "eq",
     "value": "rejected"
    },
    {
     "node": "Reply rejected",
     "subject": "request",
     "path": "body.reason",
     "op": "eq",
     "value": ""
    },
    {
     "node": "Set limit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  }
 ]
}