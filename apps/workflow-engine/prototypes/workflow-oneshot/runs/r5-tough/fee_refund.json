  }
 ],
 "tests": [
  {
   "name": "Unknown account is refused",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "account_id": "X1",
      "fee_amount": 20,
      "reason": "late fee"
     }
    ]
   },
   "mocks": {
    "Get account": {
     "items": [
      {
       "rows": [],
       "rowCount": 0
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Account not found reply",
     "subject": "request",
     "path": "body.message",
     "op": "eq",
     "value": "Account not found"
    },
    {
     "node": "Refund fee",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Branch manager review",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "name": "Premium fee of exactly the limit is refunded automatically",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "account_id": "A1",
      "fee_amount": 50,
      "reason": "monthly fee"
     }
    ]
   },
   "mocks": {
    "Get account": {
     "items": [
      {
       "rows": [
        {
         "account_id": "A1",
         "customer_id": "C1",
         "segment": "premium"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Refund fee": {
     "http": {
      "status": 200,
      "body": {
       "refund_id": "R1"
      }
     }
    },
    "Record refund": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "Notify refunded": {
     "items": [
      {
       "sent": true,
       "channel": "email"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Branch manager review",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Refund fee",
     "subject": "request",
     "path": "body.amount",
     "op": "eq",
     "value": 50
    },
    {
     "node": "Refund fee",
     "subject": "request",
     "path": "url",
     "op": "contains",
     "value": "A1"
    },
    {
     "node": "Notify refunded",
     "subject": "request",
     "path": "params.inputs.message",
     "op": "eq",
     "value": "We have refunded 50 to your account."
    },
    {
     "node": "Reply refunded",
     "subject": "request",
     "path": "body.message",
     "op": "eq",
     "value": "Refunded 50"
    }
   ]
  },
  {
   "name": "Premium fee over the limit goes to the manager, partial refund",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "account_id": "A1",
      "fee_amount": 51,
      "reason": "overdraft fee"
     }
    ]
   },
   "mocks": {
    "Get account": {
     "items": [
      {
       "rows": [
        {
         "account_id": "A1",
         "customer_id": "C1",
         "segment": "premium"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Branch manager review": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "refund_type": "partial",
       "refund_amount": 20
      },
      "decided_by": "test"
     }
    },
    "Refund fee": {
     "http": {
      "status": 200,
      "body": {
       "refund_id": "R2"
      }
     }
    },
    "Record refund": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "Notify refunded": {
     "items": [
      {
       "sent": true,
       "channel": "email"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Branch manager review",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "Refund fee",
     "subject": "request",
     "path": "body.amount",
     "op": "eq",
     "value": 20
    },
    {
     "node": "Record refund",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "Reply refunded",
     "subject": "request",
     "path": "body.message",
     "op": "eq",
     "value": "Refunded 20"
    }
   ]
  },
  {
   "name": "Standard customer small fee needs the manager, full refund",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "account_id": "A2",
      "fee_amount": 10,
      "reason": "card fee"
     }
    ]
   },
   "mocks": {
    "Get account": {
     "items": [
      {
       "rows": [
        {
         "account_id": "A2",
         "customer_id": "C2",
         "segment": "standard"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Branch manager review": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "refund_type": "full"
      },
      "decided_by": "test"
     }
    },
    "Refund fee": {
     "http": {
      "status": 200,
      "body": {
       "refund_id": "R3"
      }
     }
    },
    "Record refund": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "Notify refunded": {
     "items": [
      {
       "sent": true,
       "channel": "sms"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Branch manager review",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "Refund fee",
     "subject": "request",
     "path": "body.amount",
     "op": "eq",
     "value": 10
    },
    {
     "node": "Reply refunded",
     "subject": "request",
     "path": "body.message",
     "op": "eq",
     "value": "Refunded 10"
    }
   ]
  },
  {
   "name": "Manager rejection records nothing and declines",
   "target": {
    "kind": "workflow"
   },
   "input": {
    "items": [
     {
      "account_id": "A2",
      "fee_amount": 80,
      "reason": "service fee"
     }
    ]
   },
   "mocks": {
    "Get account": {
     "items": [
      {
       "rows": [
        {
         "account_id": "A2",
         "customer_id": "C2",
         "segment": "premium"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "Branch manager review": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "no",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "Notify declined": {
     "items": [
      {
       "sent": true,
       "channel": "email"
      }
     ]
    }
   },
   "expect": [
    {
     "node": "Refund fee",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Record refund",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "Notify declined",
     "subject": "request",
     "path": "params.inputs.message",
     "op": "eq",
     "value": "Your fee refund request was declined."
    },
    {
     "node": "Reply declined",
     "subject": "request",
     "path": "body.message",
     "op": "eq",
     "value": "Declined"
    }
   ]
  }
 ],
 "interface": {
  "kind": "form",
  "slug": "fee-refund-request",
  "title": "Fee refund request",
  "description": "",
  "access": {
   "mode": "public"
  },
  "trigger_node": "Fee refund form",
  "result_node": "Reply declined"
 }
}