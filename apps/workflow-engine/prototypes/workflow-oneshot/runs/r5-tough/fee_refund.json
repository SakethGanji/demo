{
 "name": "Fee refund request",
 "nodes": [
  {
   "name": "Fee refund form",
   "type": "FormTrigger",
   "parameters": {
    "title": "Fee refund request",
    "input_schema": {
     "type": "object",
     "properties": {
      "account_id": {
       "type": "string"
      },
      "fee_amount": {
       "type": "number"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "account_id",
      "fee_amount",
      "reason"
     ]
    }
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Get account",
   "type": "Postgres",
   "parameters": {
    "connection": "core_banking",
    "operation": "query",
    "query": "SELECT a.account_id, a.customer_id, c.segment FROM accounts a JOIN customers c ON c.customer_id = a.customer_id WHERE a.account_id = %s",
    "queryParameters": [
     "{{ $json.account_id }}"
    ]
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Account found?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.rowCount > 0 }}"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Account not found reply",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "not_found",
     "message": "Account not found"
    }
   },
   "position": {
    "x": 570,
    "y": 110
   }
  },
  {
   "name": "Gather details",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "keepOnlySet": true,
    "fields": [
     {
      "name": "account_id",
      "value": "{{ $node[\"Fee refund form\"].json.account_id }}"
     },
     {
      "name": "fee_amount",
      "value": "{{ $node[\"Fee refund form\"].json.fee_amount }}"
     },
     {
      "name": "reason",
      "value": "{{ $node[\"Fee refund form\"].json.reason }}"
     },
     {
      "name": "customer_id",
      "value": "{{ $json.rows[0].customer_id }}"
     },
     {
      "name": "segment",
      "value": "{{ $json.rows[0].segment }}"
     }
    ]
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Auto refund?",
   "type": "If",
   "parameters": {
    "condition": "{{ lower($json.segment) == 'premium' and float($json.fee_amount) <= float($vars.AUTO_REFUND_LIMIT) }}"
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Auto refund terms",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "refund_amount",
      "value": "{{ $json.fee_amount }}"
     },
     {
      "name": "approved_by_manager",
      "value": "{{ false }}"
     }
    ]
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Branch manager review",
   "type": "Approval",
   "parameters": {
    "title": "Fee refund for account {{ $json.account_id }}",
    "context": {
     "Account": "{{ $json.account_id }}",
     "Customer segment": "{{ $json.segment }}",
     "Fee amount": "{{ $json.fee_amount }}",
     "Reason": "{{ $json.reason }}"
    },
    "form": [
     {
      "name": "refund_type",
      "label": "Refund type",
      "type": "select",
      "options": [
       "full",
       "partial"
      ],
      "required": true
     },
     {
      "name": "refund_amount",
      "label": "Refund amount (partial only)",
      "type": "number",
      "required": false
     }
    ],
    "notify_email": "{{ $vars.BRANCH_MANAGER_EMAIL }}"
   },
   "position": {
    "x": 950,
    "y": 110
   }
  },
  {
   "name": "Manager refund terms",
   "type": "Set",
   "parameters": {
    "mode": "manual",
    "fields": [
     {
      "name": "refund_amount",
      "value": "{{ $json.fee_amount if $json.approval.form_data.refund_type == 'full' else $json.approval.form_data.refund_amount }}"
     },
     {
      "name": "approved_by_manager",
      "value": "{{ true }}"
     }
    ]
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Refund details",
   "type": "NoOp",
   "parameters": {},
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Refund fee",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "corebank",
     "operation_id": "refundFee"
    },
    "method": "POST",
    "url": "",
    "path_params": {
     "account_id": "{{ $json.account_id }}"
    },
    "body": {
     "amount": "{{ $json.refund_amount }}"
    }
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Record refund",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO fee_refunds (account_id, amount, approved_by_manager) VALUES (%s, %s, %s)",
      "params": [
       "{{ $node[\"Refund details\"].json.account_id }}",
       "{{ $node[\"Refund details\"].json.refund_amount }}",
       "{{ $node[\"Refund details\"].json.approved_by_manager }}"
      ]
     }
    ]
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Notify refunded",
   "type": "ExecuteWorkflow",
   "parameters": {
    "workflowId": "wf_notify_customer",
    "version": "latest",
    "inputMode": "map",
    "inputs": {
     "customer_id": "{{ $node[\"Refund details\"].json.customer_id }}",
     "message": "We have refunded {{ $node[\"Refund details\"].json.refund_amount }} to your account."
    }
   },
   "position": {
    "x": 570,
    "y": 290
   }
  },
  {
   "name": "Reply refunded",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "refunded",
     "message": "Refunded {{ $node[\"Refund details\"].json.refund_amount }}"
    }
   },
   "position": {
    "x": 760,
    "y": 290
   }
  },
  {
   "name": "Notify declined",
   "type": "ExecuteWorkflow",
   "parameters": {
    "workflowId": "wf_notify_customer",
    "version": "latest",
    "inputMode": "map",
    "inputs": {
     "customer_id": "{{ $json.customer_id }}",
     "message": "Your fee refund request was declined."
    }
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  },
  {
   "name": "Reply declined",
   "type": "Respond",
   "parameters": {
    "statusCode": 200,
    "body": {
     "status": "declined",
     "message": "Declined"
    }
   },
   "position": {
    "x": 0,
    "y": 400
   }
  }
 ],
 "connections": [
  {
   "source_node": "Fee refund form",
   "target_node": "Get account",
   "source_output": "main",
