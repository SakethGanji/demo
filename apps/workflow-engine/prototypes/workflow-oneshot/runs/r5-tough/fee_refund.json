  },
  {
   "source_node": "Auto refund?",
   "target_node": "Branch manager review",
   "source_output": "false",
   "target_input": "main"
  },
  {
   "source_node": "Auto refund terms",
   "target_node": "Refund details",
   "source_output": "main",
