{
 "name": "Overdue loan collections",
 "nodes": [
  {
   "name": "Weekdays 7am",
   "type": "Cron",
   "parameters": {
    "mode": "cron",
    "cronExpression": "0 7 * * 1-5"
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "name": "Find overdue loans",
   "type": "Postgres",
   "parameters": {
    "connection": "core_banking",
    "operation": "query",
    "query": "SELECT l.loan_id, l.outstanding, l.days_past_due, l.officer_email, c.email FROM loans l JOIN customers c ON c.customer_id = l.customer_id WHERE l.status = 'active' AND l.days_past_due >= 30",
    "queryParameters": []
   },
   "position": {
    "x": 190,
    "y": 0
   }
  },
  {
   "name": "Any overdue?",
   "type": "If",
   "parameters": {
    "condition": "{{ $json.rowCount > 0 }}"
   },
   "position": {
    "x": 380,
    "y": 0
   }
  },
  {
   "name": "Count stages",
   "type": "Code",
   "parameters": {
    "code": "rows = json_data[\"rows\"]\nreminder = 0\nfinal_notice = 0\ncollections = 0\nfor r in rows:\n    d = float(r[\"days_past_due\"])\n    if d >= 90:\n        collections = collections + 1\n    elif d >= 60:\n        final_notice = final_notice + 1\n    else:\n        reminder = reminder + 1\nreturn [new_item({\"rows\": rows, \"reminder\": reminder, \"final_notice\": final_notice, \"collections\": collections, \"total\": len(rows)})]"
   },
   "position": {
    "x": 570,
    "y": 0
   }
  },
  {
   "name": "Split loans",
   "type": "ItemLists",
   "parameters": {
    "operation": "splitOut",
    "arrayField": "rows",
    "includeOther": false
   },
   "position": {
    "x": 760,
    "y": 0
   }
  },
  {
   "name": "Each loan",
   "type": "Loop",
   "parameters": {
    "batchSize": 1
   },
   "position": {
    "x": 950,
    "y": 0
   }
  },
  {
   "name": "Route stage",
   "type": "Switch",
   "parameters": {
    "mode": "rules",
    "numberOfOutputs": 3,
    "rules": [
     {
      "output": 0,
      "field": "{{ float($node[\"Each loan\"].json.days_past_due) }}",
      "operation": "gte",
      "value": "90"
     },
     {
      "output": 1,
      "field": "{{ float($node[\"Each loan\"].json.days_past_due) }}",
      "operation": "gte",
      "value": "60"
     },
     {
      "output": 2,
      "field": "{{ float($node[\"Each loan\"].json.days_past_due) }}",
      "operation": "gte",
      "value": "30"
     }
    ]
   },
   "position": {
    "x": 1140,
    "y": 0
   }
  },
  {
   "name": "Hand to agency",
   "type": "HttpRequest",
   "parameters": {
    "api_ref": {
     "spec_id": "collections",
     "operation_id": "openCase"
    },
    "method": "POST",
    "url": "",
    "body": {
     "loan_id": "{{ $node[\"Each loan\"].json.loan_id }}",
     "outstanding": "{{ float($node[\"Each loan\"].json.outstanding) }}"
    }
   },
   "position": {
    "x": 0,
    "y": 290
   }
  },
  {
   "name": "Record collections",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO collection_actions (loan_id, stage) VALUES (%s, 'collections')",
      "params": [
       "{{ $node[\"Each loan\"].json.loan_id }}"
      ]
     }
    ]
   },
   "position": {
    "x": 190,
    "y": 290
   }
  },
  {
   "name": "Email final notice",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each loan\"].json.email }}",
    "subject": "Final notice: your loan payment is overdue",
    "bodyFormat": "plain",
    "body": "Your loan {{ $node[\"Each loan\"].json.loan_id }} is {{ $node[\"Each loan\"].json.days_past_due }} days past due. This is a final notice. Please pay the overdue amount immediately."
   },
   "position": {
    "x": 0,
    "y": 400
   }
  },
  {
   "name": "Email officer",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each loan\"].json.officer_email }}",
    "subject": "Final notice sent for loan {{ $node[\"Each loan\"].json.loan_id }}",
    "bodyFormat": "plain",
    "body": "Loan {{ $node[\"Each loan\"].json.loan_id }} is {{ $node[\"Each loan\"].json.days_past_due }} days past due. A final notice was sent to the customer."
   },
   "position": {
    "x": 190,
    "y": 400
   }
  },
  {
   "name": "Record final notice",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO collection_actions (loan_id, stage) VALUES (%s, 'final_notice')",
      "params": [
       "{{ $node[\"Each loan\"].json.loan_id }}"
      ]
     }
    ]
   },
   "position": {
    "x": 380,
    "y": 290
   }
  },
  {
   "name": "Email reminder",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $node[\"Each loan\"].json.email }}",
    "subject": "Payment reminder: your loan is overdue",
    "bodyFormat": "plain",
    "body": "Your loan {{ $node[\"Each loan\"].json.loan_id }} is {{ $node[\"Each loan\"].json.days_past_due }} days past due. Please make your payment as soon as possible."
   },
   "position": {
    "x": 0,
    "y": 510
   }
  },
  {
   "name": "Record reminder",
   "type": "Postgres",
   "parameters": {
    "connection": "ops_db",
    "operation": "transaction",
    "statements": [
     {
      "query": "INSERT INTO collection_actions (loan_id, stage) VALUES (%s, 'reminder')",
      "params": [
       "{{ $node[\"Each loan\"].json.loan_id }}"
      ]
     }
    ]
   },
   "position": {
    "x": 190,
    "y": 510
   }
  },
  {
   "name": "Email summary",
   "type": "SendEmail",
   "parameters": {
    "toEmail": "{{ $vars.COLLECTIONS_LEAD_EMAIL }}",
    "subject": "Overdue loans summary",
    "bodyFormat": "plain",
    "body": "Overdue loans handled today: {{ $node[\"Count stages\"].json.total }}\nReminders: {{ $node[\"Count stages\"].json.reminder }}\nFinal notices: {{ $node[\"Count stages\"].json.final_notice }}\nCollections: {{ $node[\"Count stages\"].json.collections }}"
   },
   "position": {
    "x": 1140,
    "y": 110
   }
  }
 ],
