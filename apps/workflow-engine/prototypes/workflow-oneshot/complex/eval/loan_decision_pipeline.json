{
 "id": "loan_decision_pipeline",
 "request": "Loan applications are posted to us with applicant_id, product (personal, auto or mortgage), amount and income. Run a credit check and a fraud check on the applicant. If the fraud check flags them, decline straight away. Otherwise decide by credit score: below 580 is declined; 580 to 719 goes to an underwriter; 720 or above is approved automatically, except mortgages, which always go to an underwriter. For the underwriter, have the AI write a short summary of the application to read alongside the numbers. Book approved loans in the loan system; record declined ones in the loan system as declines with a reason. Reply with the decision.",
 "apis": [
  "bureau.yaml",
  "fraudcheck.yaml",
  "loans.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "Webhook",
  "must_have_types": [
   "If|Switch",
   "Approval",
   "AIAgent|LLMChat",
   "Respond"
  ],
  "must_call": [
   "bureau.creditScore",
   "fraudcheck.check",
   "loans.book",
   "loans.decline"
  ],
  "max_nodes": 20
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Good score personal loan is booked without an underwriter",
   "input": {
    "items": [
     {
      "body": {
       "applicant_id": "AP-1",
       "product": "personal",
       "amount": 15000,
       "income": 70000
      },
      "headers": {},
      "query": {},
      "method": "POST"
     }
    ]
   },
   "mocks": {
    "$api:bureau.creditScore": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "AP-1",
       "score": 720
      }
     }
    },
    "$api:fraudcheck.check": {
     "http": {
      "status": 200,
      "body": {
       "applicant_id": "AP-1",
       "flagged": false
      }
     }
    },
    "$api:loans.book": {
     "http": {
      "status": 200,
      "body": {
       "loan_id": "LN-1"
      }
     }
    },
    "$api:loans.decline": {
     "http": {
      "status": 200,
      "body": {
       "decline_id": "D-1"
      }
     }
    },
    "$all:AIAgent?": {
     "items": [
      {
       "response": "Applicant summary",
       "structured": {
        "summary": "Applicant summary"
       }
      }
     ]
    },
    "$all:LLMChat?": {
     "items": [
      {
       "response": "Applicant summary"
      }
     ]
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$api:loans.book",
     "subject": "request",
     "item": "any",
     "path": "body.product",
     "op": "eq",
     "value": "personal"
    },
    {
     "node": "$api:loans.book",
     "subject": "request",
     "item": "any",
     "path": "body.amount",
     "op": "eq",
     "value": 15000
    },
    {
     "node": "$all:Approval?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:loans.decline",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
