{
 "id": "address_change_reuse",
 "request": "Customers change their address on a form with their customer id, the new address and the id of the document they uploaded. Verify their identity with our identity check. If verified, update the address in the CRM and let the customer know their address was changed (use our usual customer notification). If not verified, show 'We could not verify you' and change nothing.",
 "apis": [
  "crm.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "FormTrigger",
  "must_have_types": [
   "ExecuteWorkflow",
   "If|Switch"
  ],
  "must_call": [
   "crm.updateAddress"
  ],
  "max_nodes": 10,
  "min_types": {
   "ExecuteWorkflow": 2
  },
  "interface_kind": "form"
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Verified: address changed and customer told",
   "input": {
    "items": [
     {
      "customer_id": "C-4",
      "new_address": "12 High St, Leeds",
      "document_id": "D-4"
     }
    ]
   },
   "mocks": {
    "$wf:wf_kyc_verify": {
     "items": [
      {
       "verified": true,
       "reason": "ok"
      }
     ]
    },
    "$wf:wf_notify_customer?": {
     "items": [
      {
       "sent": true,
       "channel": "sms"
      }
     ]
    },
    "$api:crm.updateAddress": {
     "http": {
      "status": 200,
      "body": {
       "customer_id": "C-4"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:crm.updateAddress",
     "subject": "request",
     "item": "any",
     "path": "body.address",
     "op": "eq",
     "value": "12 High St, Leeds"
    },
    {
     "node": "$api:crm.updateAddress",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "C-4"
    },
    {
     "node": "$wf:wf_kyc_verify",
     "subject": "request",
     "item": "any",
     "path": "params.inputs.document_id",
     "op": "eq",
     "value": "D-4"
    },
    {
     "node": "$wf:wf_notify_customer",
     "subject": "request",
     "item": "any",
     "path": "params.inputs.customer_id",
     "op": "eq",
     "value": "C-4"
    },
    {
     "node": "$wf:wf_notify_customer",
     "subject": "request",
     "item": "any",
     "path": "params.inputs.message",
     "op": "matches",
     "value": "(?i)address"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Not verified: nothing changes, nobody notified",
   "input": {
    "items": [
     {
      "customer_id": "C-4",
      "new_address": "12 High St, Leeds",
      "document_id": "D-4"
     }
    ]
   },
   "mocks": {
    "$wf:wf_kyc_verify": {
     "items": [
      {
       "verified": false,
       "reason": "ok"
      }
     ]
    },
    "$wf:wf_notify_customer?": {
     "items": [
      {
       "sent": true,
       "channel": "sms"
      }
     ]
    },
    "$api:crm.updateAddress": {
     "http": {
      "status": 200,
      "body": {
       "customer_id": "C-4"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:crm.updateAddress",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$wf:wf_notify_customer?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$last",
     "subject": "request",
     "item": "any",
     "path": "body.message",
     "op": "matches",
     "value": "(?i)could not verify"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Identity check gets the customer",
   "input": {
    "items": [
     {
      "customer_id": "C-4",
      "new_address": "12 High St, Leeds",
      "document_id": "D-4"
     }
    ]
   },
   "mocks": {
    "$wf:wf_kyc_verify": {
     "items": [
      {
       "verified": true,
       "reason": "ok"
      }
     ]
    },
    "$wf:wf_notify_customer?": {
     "items": [
      {
       "sent": true,
       "channel": "sms"
      }
     ]
    },
    "$api:crm.updateAddress": {
     "http": {
      "status": 200,
      "body": {
       "customer_id": "C-4"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$wf:wf_kyc_verify",
     "subject": "request",
     "item": "any",
     "path": "params.inputs.customer_id",
     "op": "eq",
     "value": "C-4"
    },
    {
     "node": "$wf:wf_notify_customer",
     "subject": "node",
     "op": "status",
     "value": "success"
    }
   ]
  }
 ],
 "variables": {
  "WIRE_OPS_EMAIL": {
   "value": "wireops@bank.test"
  },
  "BRANCH_OPS_EMAIL": {
   "value": "branchops@bank.test"
  },
  "FINANCE_OPS_EMAIL": {
   "value": "finops@bank.test"
  },
  "ATM_DAILY_LIMIT": {
   "value": "1000",
   "description": "standard ATM limit per day, USD"
  },
  "COMPLIANCE_EMAIL": {
   "value": "compliance@bank.test"
  },
  "CARDS_API_KEY": {
   "value": "sk-test-123",
   "secret": true
  }
 },
 "subworkflows": [
  {
   "id": "wf_kyc_verify",
   "name": "Verify customer identity",
   "description": "Checks a customer's ID document against our KYC provider and records the result.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "document_id",
     "type": "string",
     "required": true
    }
   ],
   "output_fields": [
    "verified",
    "reason"
   ],
   "definition": {
    "name": "child",
    "nodes": [
     {
      "name": "Called",
      "type": "ExecuteWorkflowTrigger",
      "parameters": {
       "inputSource": "fields",
       "fields": [
        {
         "name": "customer_id",
         "type": "string",
         "required": true
        },
        {
         "name": "document_id",
         "type": "string",
         "required": true
        }
       ]
      }
     },
     {
      "name": "Result",
      "type": "Set",
      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "verified",
         "value": "{{ true }}"
        },
        {
         "name": "reason",
         "value": "ok"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  },
  {
   "id": "wf_notify_customer",
   "name": "Notify customer",
   "description": "Sends a customer a message on their preferred channel (sms or email) and logs it.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "message",
     "type": "string",
     "required": true
    }
   ],
   "output_fields": [
    "sent",
    "channel"
   ],
   "definition": {
    "name": "child",
    "nodes": [
     {
      "name": "Called",
      "type": "ExecuteWorkflowTrigger",
      "parameters": {
       "inputSource": "fields",
       "fields": [
        {
         "name": "customer_id",
         "type": "string",
         "required": true
        },
        {
         "name": "message",
         "type": "string",
         "required": true
        }
       ]
      }
     },
     {
      "name": "Result",
      "type": "Set",
      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "sent",
         "value": "{{ true }}"
        },
        {
         "name": "channel",
         "value": "sms"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  }
 ]
}