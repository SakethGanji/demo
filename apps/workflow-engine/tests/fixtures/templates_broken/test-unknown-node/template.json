{
  "format": "wf-template/1",
  "slug": "test-unknown-node",
  "version": "1.0.0",
  "name": "Fixture test-unknown-node",
  "summary": "A fixture bundle.",
  "category": "fixtures",
  "tags": [],
  "min_engine_stage": 8,
  "requires": {
    "templates": [],
    "secrets": [],
    "variables": [],
    "egress_hosts": []
