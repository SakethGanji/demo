   "type": "Code"
  },
  {
   "step": "Send digest",
   "node": "Send digest",
   "type": "SendEmail"
  }
 ],
 "ops": [
  {
   "op": "add_node",
   "args": {
    "name": "Monday 7am",
    "type": "Cron",
    "parameters": {
     "mode": "cron",
     "cronExpression": "0 7 * * 1"
    }
   },
   "why": "r1: minute hour day month weekday; 1 = Monday"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Find low balances",
    "type": "Postgres",
    "parameters": {
     "connectionString": "{{ $vars.REPORTING_DB_URL }}",
     "operation": "query",
     "query": "SELECT account_ref, branch, balance FROM savings_accounts WHERE balance < %s ORDER BY balance ASC",
     "queryParameters": [
      200
     ]
    }
   },
   "why": "Connection string comes from a project variable, never typed in; SELECT gives ONE item {rows, rowCount}"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Any low balances?",
    "type": "If",
    "parameters": {
     "condition": "{{ $json.rowCount > 0 }}"
    }
   },
   "why": "r3: the false port stays unconnected, so nothing is sent"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Build digest",
    "type": "Code",
    "parameters": {
     "code": "rows = json_data['rows']\nlines = [r['account_ref'] + ' (' + r['branch'] + '): ' + str(r['balance']) for r in rows]\nreturn [new_item({'count': len(rows), 'body': ' | '.join(lines)})]"
    }
   },
   "why": "r2: fold all rows into one item so one email is sent"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Send digest",
    "type": "SendEmail",
    "parameters": {
     "toEmail": "{{ $vars.BRANCH_OPS_EMAIL }}",
     "subject": "Low balance digest: {{ $json.count }} accounts",
     "bodyFormat": "plain",
     "body": "{{ $json.body }}"
    }
   },
   "why": "r2: one email"
  },
  {
   "op": "connect",
   "args": {
    "source": "Monday 7am",
    "target": "Find low balances"
   },
   "why": ""
  },
