 "spec": {
  "spec_version": 1,
  "title": "Weekly low-balance digest",
  "summary": "Every Monday at 7am, list savings accounts under 200 and email one digest to branch operations. Send nothing when there are none.",
  "trigger": {
   "kind": "cron",
   "fields": []
  },
  "rules": [
   {
    "id": "r1",
    "text": "Every Monday at 7am the savings accounts with a balance under 200 are collected."
   },
   {
    "id": "r2",
    "text": "When there are such accounts, ONE email lists all of them."
   },
   {
    "id": "r3",
    "text": "When there are none, no email is sent."
   }
  ],
  "steps": [
