    "name": "Monday 7am",
    "node_type": "Cron",
    "purpose": "Run every Monday at 07:00",
    "rules": [
     "r1"
    ]
   },
   {
    "name": "Find low balances",
    "node_type": "Postgres",
    "purpose": "Select accounts with balance < 200",
    "rules": [
     "r1"
    ]
   },
   {
    "name": "Any low balances?",
    "node_type": "If",
    "purpose": "rowCount > 0",
    "rules": [
     "r2",
     "r3"
    ]
   },
   {
    "name": "Build digest",
    "node_type": "Code",
    "purpose": "Turn the rows into one text block",
    "rules": [
     "r2"
    ]
   },
   {
    "name": "Send digest",
    "node_type": "SendEmail",
    "purpose": "Email branch operations",
    "rules": [
     "r2"
    ]
   }
  ],
  "interface": null,
