 "plan": [
  {
   "step": "Monday 7am",
   "node": "Monday 7am",
   "type": "Cron"
  },
  {
   "step": "Find low balances",
   "node": "Find low balances",
   "type": "Postgres"
  },
  {
   "step": "Any low balances?",
   "node": "Any low balances?",
   "type": "If"
  },
  {
   "step": "Build digest",
