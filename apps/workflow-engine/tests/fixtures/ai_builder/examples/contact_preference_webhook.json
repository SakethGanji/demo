   "why": ""
  },
  {
   "op": "add_node",
   "args": {
    "name": "Reject unknown channel",
    "type": "Respond",
    "parameters": {
     "statusCode": 422,
     "body": {
      "error": "channel must be email, sms or post"
     }
    }
   },
   "why": "r4: only the fallback port reaches this"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Save preference",
    "type": "DataTable",
    "parameters": {
     "table": "contact_preferences",
     "operation": "insert",
     "data": {
      "customer_id": "{{ $json.customer_id }}",
      "channel": "{{ $json.channel }}",
      "contact": "{{ $json.contact }}"
     }
    }
   },
   "why": "Three branches feed this one node"
  },
