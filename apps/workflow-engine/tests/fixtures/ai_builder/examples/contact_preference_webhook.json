 "ops": [
  {
   "op": "add_node",
   "args": {
    "name": "Preference webhook",
    "type": "Webhook",
    "parameters": {
     "method": "POST",
     "path": "contact-preference",
     "responseMode": "lastNode"
    }
   },
   "why": "Webhook data is under $json.body"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Which channel?",
    "type": "Switch",
    "parameters": {
     "numberOfOutputs": 3,
     "mode": "rules",
     "rules": [
      {
       "output": 0,
       "field": "body.channel",
       "operation": "equals",
       "value": "email"
      },
      {
       "output": 1,
       "field": "body.channel",
       "operation": "equals",
       "value": "sms"
      },
      {
       "output": 2,
       "field": "body.channel",
       "operation": "equals",
       "value": "post"
      }
     ]
    }
   },
   "why": "Three cases = ports output0..output2; anything else goes to the fallback port"
  },
  {
   "op": "add_node",
   "args": {
    "name": "Prepare email record",
    "type": "Set",
    "parameters": {
     "mode": "manual",
     "keepOnlySet": true,
     "fields": [
      {
       "name": "customer_id",
       "value": "{{ $json.body.customer_id }}"
      },
      {
       "name": "channel",
       "value": "email"
      },
      {
       "name": "contact",
       "value": "{{ $json.body.value }}"
      }
     ]
    }
   },
   "why": ""
  },
  {
