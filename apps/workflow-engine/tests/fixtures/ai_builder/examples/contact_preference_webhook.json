{
 "id": "contact_preference_webhook",
 "request": "Our site posts a customer's contact preference to us: customer id, channel (email, sms or post) and the address or number. Save it and confirm. Reject any other channel with a 422 and save nothing.",
 "spec": {
  "spec_version": 1,
  "title": "Contact preference update",
  "summary": "A webhook receives a customer's preferred contact channel (email, sms or post), saves it and confirms. Any other channel is refused.",
  "trigger": {
   "kind": "webhook",
   "fields": []
  },
  "rules": [
   {
    "id": "r1",
    "text": "A preference for email is saved with channel 'email'."
   },
   {
    "id": "r2",
    "text": "A preference for sms is saved with channel 'sms'."
   },
   {
    "id": "r3",
    "text": "A preference for post is saved with channel 'post'."
   },
   {
    "id": "r4",
    "text": "Any other channel is refused with a 422 reply and nothing is saved."
   },
   {
    "id": "r5",
    "text": "A saved preference is confirmed to the caller."
   }
  ],
  "steps": [
   {
    "name": "Preference webhook",
    "node_type": "Webhook",
    "purpose": "Receive the update",
    "rules": []
   },
   {
    "name": "Which channel?",
    "node_type": "Switch",
    "purpose": "Route on body.channel",
    "rules": [
     "r1",
     "r2",
     "r3",
     "r4"
    ]
   },
   {
    "name": "Prepare email record",
    "node_type": "Set",
    "purpose": "Shape the record for email",
    "rules": [
     "r1"
    ]
   },
   {
    "name": "Prepare SMS record",
    "node_type": "Set",
    "purpose": "Shape the record for sms",
    "rules": [
     "r2"
    ]
   },
   {
    "name": "Prepare postal record",
    "node_type": "Set",
    "purpose": "Shape the record for post",
    "rules": [
     "r3"
    ]
   },
   {
    "name": "Reject unknown channel",
    "node_type": "Respond",
    "purpose": "Reply 422",
    "rules": [
     "r4"
    ]
   },
   {
    "name": "Save preference",
    "node_type": "DataTable",
    "purpose": "Insert into contact_preferences",
    "rules": [
     "r1",
     "r2",
     "r3",
     "r5"
    ]
   },
   {
    "name": "Confirm",
    "node_type": "Respond",
    "purpose": "Reply 200",
    "rules": [
     "r5"
    ]
   }
  ],
  "interface": null,
