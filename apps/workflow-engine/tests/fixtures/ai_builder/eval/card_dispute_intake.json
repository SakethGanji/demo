          "node": "$api:disputes.createCase",
          "subject": "node",
          "op": "status",
          "value": "success"
        },
        {
          "node": "$api:disputes.createCase",
          "subject": "request",
          "item": "any",
          "path": "body.amount",
          "op": "eq",
          "value": 120
        },
        {
          "node": "$api:disputes.createCase",
          "subject": "request",
          "item": "any",
          "path": "body.merchant",
          "op": "eq",
          "value": "Hotel Aurora"
        },
        {
          "node": "$api:cards.provisionalCredit",
          "subject": "node",
          "op": "status",
          "value": "not_run"
        },
        {
          "node": "$api:notify.sendMessage",
          "subject": "request",
          "item": "any",
          "path": "body.text",
          "op": "contains",
          "value": "CASE-5521"
        },
        {
          "node": "$last",
          "subject": "node",
