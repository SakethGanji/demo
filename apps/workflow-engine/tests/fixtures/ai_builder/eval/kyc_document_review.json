      "mocks": {
        "$type:AIAgent": {
          "items": [
            {
              "response": "",
              "structured": {
                "complete": true,
                "is_complete": true,
                "missing_documents": [],
                "missing": []
              }
            }
          ]
        },
        "$api:kyc.requestDocuments": {
          "http": {
            "status": 200,
            "body": {
              "request_id": "DR-9"
            }
