        "$api:kyc.updateStatus": {
          "http": {
            "status": 200,
            "body": {
              "customer_id": "c-1042",
              "status": "approved"
            }
          }
        },
        "$type:Approval": {
          "port": "approved",
          "approval": {
            "decision": "approved",
            "comment": "",
            "form_data": {},
            "decided_by": "test"
          }
        }
      },
      "expect": [
        {
          "node": "$type:Approval",
          "subject": "node",
          "op": "status",
          "value": "success"
        },
        {
          "node": "$api:kyc.requestDocuments",
          "subject": "node",
          "op": "status",
          "value": "not_run"
        },
        {
          "node": "$api:kyc.updateStatus",
          "subject": "node",
          "op": "status",
          "value": "success"
        },
        {
          "node": "$api:kyc.updateStatus",
          "subject": "request",
          "item": "any",
          "path": "body.status",
          "op": "eq",
          "value": "approved"
        },
        {
          "node": "$api:kyc.updateStatus",
          "subject": "request",
          "item": "any",
          "path": "url",
          "op": "contains",
          "value": "c-1042"
        }
      ],
      "category": "normal"
    },
