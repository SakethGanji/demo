{
  "id": "complaint_routing",
  "holdout": false,
  "request": "Staff log a complaint on a form with the customer id, which product it is about (cards, loans or deposits), whether it is urgent (an urgent flag, true or false), and a description. Create a ticket in the queue of the matching team: the queue is named cards, loans or deposits. If the complaint is urgent, also page the on-call person with a message. Do not message the customer.",
  "apis": [
    "queues.yaml",
    "notify.yaml"
  ],
  "spec_edits": null,
  "expect": {
    "trigger": "FormTrigger",
    "must_have_types": [
      "If|Switch"
    ],
    "must_call": [
      "queues.create",
      "notify.sendMessage"
    ],
    "must_not_call_hosts": [],
    "approval_ports_wired": [],
    "interface_kind": "form",
    "max_nodes": 14,
    "forbid_types": [
      "Approval"
    ],
    "min_spec_tests": 4
  },
  "hidden_tests": [
    {
      "name": "A card complaint goes to the cards queue",
      "target": {
        "kind": "workflow"
      },
      "input": {
        "items": [
          {
            "customer_id": "c-4410",
            "product": "cards",
            "urgent": false,
            "description": "Nobody has called me back"
          }
        ]
      },
      "mocks": {
        "$api:queues.create": {
          "http": {
            "status": 201,
            "body": {
              "ticket_id": "TK-1",
              "queue": "cards"
            }
          }
        },
        "$api:notify.sendMessage": {
          "http": {
            "status": 200,
            "body": {
              "delivered": true
            }
          }
        },
        "$type:AIAgent?": {
          "items": [
            {
              "customer_id": "c-4410",
              "product": "cards",
              "urgent": false,
              "description": "Nobody has called me back",
              "output": {
                "product": "cards",
                "urgent": false
              }
            }
          ]
        }
      },
      "expect": [
        {
          "node": "$api:queues.create",
          "subject": "node",
          "op": "status",
          "value": "success"
        },
        {
          "node": "$api:queues.create",
          "subject": "request",
          "item": "any",
          "path": "body.queue",
          "op": "eq",
          "value": "cards"
        },
        {
          "node": "$api:notify.sendMessage",
          "subject": "node",
          "op": "status",
          "value": "not_run"
        }
      ],
      "category": "normal"
    },
    {
      "name": "A loan complaint goes to the loans queue",
