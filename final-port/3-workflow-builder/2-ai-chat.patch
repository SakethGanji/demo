+    """The editor chat builds with the one-shot builder unless ``WF_CHAT_BUILDER=legacy`` (the staged spec -> ops builder)."""
+    return (os.environ.get("WF_CHAT_BUILDER") or "oneshot").strip().lower() != "legacy"
+
