{
 "id": "fee_refund",
 "request": "Branch staff log fee refund requests on a form with account_id, fee_amount and reason. Look up the account and its customer's segment in core banking. If the account isn't found, show 'Account not found' and stop. A premium customer's fee up to AUTO_REFUND_LIMIT is refunded in full automatically. Everything else goes to the branch manager (BRANCH_MANAGER_EMAIL), who chooses refund_type (full or partial) and, for partial, enters refund_amount. Refund through core banking's refundFee: the full fee, or the manager's refund_amount for a partial refund. Then record it in ops_db fee_refunds (account id, amount refunded, approved_by_manager true or false) and tell the customer with the Notify customer sub-workflow: 'We have refunded <amount> to your account.' If the manager rejects, record nothing and notify the customer 'Your fee refund request was declined.' Show the staff member 'Refunded <amount>' or 'Declined'.",
 "apis": [
  "corebank.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "FormTrigger",
  "must_have_types": [
   "Postgres",
   "Approval",
   "ExecuteWorkflow"
  ],
  "must_call": [
   "corebank.refundFee"
  ],
  "interface_kind": "form",
  "max_nodes": 22
 },
