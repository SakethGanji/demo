      "account_id": "A5",
      "fee_amount": 50,
      "reason": "overdraft fee in error"
     }
    ]
   },
   "mocks": {
    "$pg:accounts": {
     "items": [
      {
       "rows": [
        {
         "account_id": "A5",
         "customer_id": "CU5",
         "product": "current",
         "balance": "120.00",
         "status": "open",
         "segment": "premium"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "$pg:customers!accounts?": {
     "items": [
      {
       "rows": [
        {
         "customer_id": "CU5",
         "segment": "premium",
         "full_name": "Kim",
         "email": "kim@mail.test"
        }
       ],
       "rowCount": 1
      }
     ]
    },
    "$api:corebank.refundFee": {
     "http": {
      "status": 200,
      "body": {
       "refund_id": "R1"
      }
     }
    },
    "$pgw:fee_refunds": {
     "items": [
      {
       "success": true
      }
     ]
    },
    "$wf:wf_notify_customer": {
     "items": [
      {
       "sent": true,
       "channel": "sms"
      }
     ]
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
