       "customer_confirmed": "yes"
      },
      "decided_by": "test"
     }
    },
    "$nth:Approval:PAYMENTS_OPS_EMAIL:2?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {
       "customer_confirmed": "yes"
      },
      "decided_by": "test"
     }
    },
    "$nth:Approval:MLRO_EMAIL:1?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
