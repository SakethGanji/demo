{
 "id": "wire_settlement_tracker",
 "request": "Sent wires are tracked in the wire_tracking table. Every 10 minutes, check each wire whose status is 'sent' with the wire status service. Settled: set its status to settled. Failed: set it to failed and email wire ops the wire id. Still pending: add one to its check count, and if it had already been checked 12 times (two hours), set it to stuck instead and email wire ops the wire id.",
 "apis": [
  "wires.yaml"
 ],
 "tables": {
  "wire_tracking": [
   {
    "name": "wire_id",
    "type": "string"
   },
   {
    "name": "status",
    "type": "string"
   },
   {
    "name": "checks",
    "type": "number"
   }
  ]
 },
 "expect": {
  "trigger": "Cron",
  "must_have_types": [
   "DataTable",
   "SendEmail"
  ],
  "must_call": [
   "wires.wireStatus"
  ],
  "max_nodes": 16,
  "forbid_types": [
   "Poll",
   "Wait"
  ]
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Settled is marked settled, no email",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "wire_id": "W-1",
       "status": "sent",
       "checks": 2
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:wires.wireStatus": {
     "http": {
      "status": 200,
      "body": {
       "wire_id": "x",
       "status": "settled"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "settled"
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:wires.wireStatus",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "W-1"
    },
    {
     "node": "$op:DataTable.list",
     "subject": "request",
     "item": "any",
     "path": "params.filter.status",
     "op": "eq",
     "value": "sent"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Failed second wire: marked failed, wire ops told which",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "wire_id": "W-1",
       "status": "sent",
       "checks": 0
      },
      {
       "id": 2,
       "wire_id": "W-2",
       "status": "sent",
       "checks": 0
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:wires.wireStatus": {
     "http": {
      "status": 200,
      "body": {
       "wire_id": "x",
       "status": "{{ 'failed' if 'W-2' in json_stringify($json) else 'settled' }}"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:wires.wireStatus",
     "subject": "request",
     "op": "count",
     "value": 2
    },
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "failed"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.toEmail",
     "op": "eq",
     "value": "wireops@bank.test"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.body",
     "op": "contains",
     "value": "W-2"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Pending: check count goes up",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "wire_id": "W-3",
       "status": "sent",
       "checks": 3
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:wires.wireStatus": {
     "http": {
      "status": 200,
      "body": {
       "wire_id": "x",
       "status": "pending"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.checks",
     "op": "eq",
     "value": 4
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Pending after 12 checks is stuck",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "wire_id": "W-4",
       "status": "sent",
       "checks": 12
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:wires.wireStatus": {
     "http": {
      "status": 200,
      "body": {
       "wire_id": "x",
       "status": "pending"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "stuck"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.body",
     "op": "contains",
     "value": "W-4"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "11 checks is not stuck yet",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "wire_id": "W-5",
       "status": "sent",
       "checks": 11
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:wires.wireStatus": {
     "http": {
      "status": 200,
      "body": {
       "wire_id": "x",
       "status": "pending"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.checks",
     "op": "eq",
     "value": 12
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  }
 ],
 "variables": {
  "WIRE_OPS_EMAIL": {
   "value": "wireops@bank.test"
  },
  "BRANCH_OPS_EMAIL": {
   "value": "branchops@bank.test"
  },
  "FINANCE_OPS_EMAIL": {
   "value": "finops@bank.test"
  },
  "ATM_DAILY_LIMIT": {
   "value": "1000",
   "description": "standard ATM limit per day, USD"
  },
  "COMPLIANCE_EMAIL": {
   "value": "compliance@bank.test"
  },
  "CARDS_API_KEY": {
   "value": "sk-test-123",
   "secret": true
  }
 },
 "subworkflows": [
  {
   "id": "wf_kyc_verify",
   "name": "Verify customer identity",
   "description": "Checks a customer's ID document against our KYC provider and records the result.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "document_id",
     "type": "string",
     "required": true
    }
   ],
   "output_fields": [
    "verified",
    "reason"
   ],
   "definition": {
    "name": "child",
    "nodes": [
     {
      "name": "Called",
      "type": "ExecuteWorkflowTrigger",
      "parameters": {
       "inputSource": "fields",
       "fields": [
        {
         "name": "customer_id",
         "type": "string",
         "required": true
        },
        {
         "name": "document_id",
         "type": "string",
         "required": true
        }
       ]
      }
     },
     {
      "name": "Result",
      "type": "Set",
      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "verified",
         "value": "{{ true }}"
        },
        {
         "name": "reason",
         "value": "ok"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  },
  {
   "id": "wf_notify_customer",
   "name": "Notify customer",
   "description": "Sends a customer a message on their preferred channel (sms or email) and logs it.",
   "inputs": [
    {
     "name": "customer_id",
     "type": "string",
     "required": true
    },
    {
     "name": "message",
     "type": "string",
     "required": true
    }
   ],
   "output_fields": [
    "sent",
    "channel"
   ],
   "definition": {
    "name": "child",
    "nodes": [
     {
      "name": "Called",
      "type": "ExecuteWorkflowTrigger",
      "parameters": {
       "inputSource": "fields",
       "fields": [
        {
         "name": "customer_id",
         "type": "string",
         "required": true
        },
        {
         "name": "message",
         "type": "string",
         "required": true
        }
       ]
      }
     },
     {
      "name": "Result",
      "type": "Set",
      "parameters": {
       "mode": "manual",
       "keepOnlySet": true,
       "fields": [
        {
         "name": "sent",
         "value": "{{ true }}"
        },
        {
         "name": "channel",
         "value": "sms"
        }
       ]
      }
     }
    ],
    "connections": [
     {
      "source_node": "Called",
      "target_node": "Result",
      "source_output": "main",
      "target_input": "main"
     }
    ]
   }
  }
 ]
}