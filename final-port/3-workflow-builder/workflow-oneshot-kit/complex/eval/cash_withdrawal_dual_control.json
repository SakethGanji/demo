{
 "id": "cash_withdrawal_dual_control",
 "request": "Tellers request a large cash withdrawal on a form with the account id, the amount and the customer's name. Up to $10,000 is approved automatically. Over $10,000 needs the branch manager's approval, and over $50,000 needs regional operations to approve as well, after the branch manager. If anyone rejects, nothing is debited. When it is approved, debit the account through core banking. If the debit call fails, show the teller 'Debit failed - do not hand out cash'. Record every request in the withdrawals table (account id, amount, customer name and the final status: approved, rejected or failed) and show the teller the outcome.",
 "apis": [
  "core.yaml"
 ],
 "tables": {
  "withdrawals": [
   {
    "name": "account_id",
    "type": "string"
   },
   {
    "name": "amount",
    "type": "number"
   },
   {
    "name": "customer_name",
    "type": "string"
   },
   {
    "name": "status",
    "type": "string"
   }
  ]
 },
 "expect": {
  "trigger": "FormTrigger",
  "must_have_types": [
   "Approval",
   "If|Switch",
   "DataTable",
   "Respond"
  ],
  "must_call": [
   "core.debit"
  ],
  "interface_kind": "form",
  "max_nodes": 22,
  "min_types": {
   "Approval": 2
  }
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Small amount is debited without approval",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 5000
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "X1"
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$all:Approval?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:core.debit",
     "subject": "request",
     "item": "any",
     "path": "body.amount",
     "op": "eq",
     "value": 5000
    },
    {
     "node": "$api:core.debit",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "AC-7"
    },
    {
     "node": "$op:DataTable.insert|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "approved"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Exactly 10,000 needs no approval",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 10000
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "X1"
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$all:Approval?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:core.debit",
     "subject": "node",
     "op": "status",
     "value": "success"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Manager approves a mid amount",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 20000
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "X1"
      }
     }
    },
    "$all:Approval": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$api:core.debit",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "$all:Approval",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$op:DataTable.insert|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "approved"
    },
    {
     "node": "$op:DataTable.insert|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.customer_name",
     "op": "eq",
     "value": "Dana Reyes"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Over 50,000 needs both approvals before the debit",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 60000
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "X1"
      }
     }
    },
    "$all:Approval": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$all:Approval",
     "subject": "request",
     "op": "count",
     "value": 2
    },
    {
     "node": "$api:core.debit",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "$api:core.debit",
     "subject": "request",
     "item": "any",
     "path": "body.amount",
     "op": "eq",
     "value": 60000
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Large amount rejected: nothing debited, recorded rejected",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 80000
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "http": {
      "status": 200,
      "body": {
       "txn_id": "X1"
      }
     }
    },
    "$all:Approval": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "expect": [
    {
     "node": "$api:core.debit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$op:DataTable.insert|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "rejected"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Debit fails: recorded failed",
   "input": {
    "items": [
     {
      "account_id": "AC-7",
      "customer_name": "Dana Reyes",
      "amount": 900
     }
    ]
   },
   "mocks": {
    "$api:core.debit": {
     "error": {
      "message": "core banking unavailable",
      "code": "ECONN"
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    }
   },
   "allow_node_errors": true,
   "expect": [
    {
     "node": "$op:DataTable.insert|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "failed"
    }
   ]
  }
 ]
}