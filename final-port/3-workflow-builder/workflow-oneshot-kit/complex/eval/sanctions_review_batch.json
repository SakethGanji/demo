{
 "id": "sanctions_review_batch",
 "request": "Every weekday at 7am, take the rows in the sanctions_review table whose status is pending. Screen each person's name and country with the screening service. On a hit, set that row's status to hit and open a compliance case naming the person. With no hit, set the row's status to cleared. Finally, email compliance a list of the names that were hits. If nobody was a hit, send no email.",
 "apis": [
  "screening.yaml",
  "compliance.yaml"
 ],
 "tables": {
  "sanctions_review": [
   {
    "name": "name",
    "type": "string"
   },
   {
    "name": "country",
    "type": "string"
   },
   {
    "name": "status",
    "type": "string"
   }
  ]
 },
 "expect": {
  "trigger": "Cron",
  "must_have_types": [
   "DataTable",
   "SendEmail"
  ],
  "must_call": [
   "screening.screen",
   "compliance.openCase"
  ],
  "max_nodes": 18
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "One hit, one cleared",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 2,
       "name": "Ana Silva",
       "country": "BR",
       "status": "pending"
      },
      {
       "id": 1,
       "name": "Ivan Petrov",
       "country": "RU",
       "status": "pending"
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": "{{ 'Ivan Petrov' in json_stringify($json) }}",
       "list": "OFAC"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:screening.screen",
     "subject": "request",
     "op": "count",
     "value": 2
    },
    {
     "node": "$api:compliance.openCase",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$api:compliance.openCase",
     "subject": "request",
     "item": "any",
     "path": "body.subject",
     "op": "contains",
     "value": "Ivan Petrov"
    },
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.body",
     "op": "contains",
     "value": "Ivan Petrov"
    },
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.rowId",
     "op": "one_of",
     "value": [
      1,
      "1"
     ]
    },
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.rowId",
     "op": "one_of",
     "value": [
      2,
      "2"
     ]
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Nobody is a hit: no case, no email",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 2,
       "name": "Ana Silva",
       "country": "BR",
       "status": "pending"
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 2
      }
     ]
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": "{{ 'Ivan Petrov' in json_stringify($json) }}",
       "list": "OFAC"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:screening.screen",
     "subject": "request",
     "op": "count",
     "value": 1
    },
    {
     "node": "$api:compliance.openCase",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "cleared"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "A hit row is marked hit",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 1,
       "name": "Ivan Petrov",
       "country": "RU",
       "status": "pending"
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": "{{ 'Ivan Petrov' in json_stringify($json) }}",
       "list": "OFAC"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.update|upsert",
     "subject": "request",
     "item": "any",
     "path": "params.data.status",
     "op": "eq",
     "value": "hit"
    },
    {
     "node": "$api:screening.screen",
     "subject": "request",
     "item": "any",
     "path": "body.name",
     "op": "eq",
     "value": "Ivan Petrov"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "No pending rows: nothing screened",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": []
    },
    "$op:DataTable.update|upsert?": {
     "items": []
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": "{{ 'Ivan Petrov' in json_stringify($json) }}",
       "list": "OFAC"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$api:screening.screen",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Only pending rows are asked for",
   "input": {
    "items": [
     {}
    ]
   },
   "mocks": {
    "$op:DataTable.list": {
     "items": [
      {
       "id": 2,
       "name": "Ana Silva",
       "country": "BR",
       "status": "pending"
      }
     ]
    },
    "$op:DataTable.update|upsert": {
     "items": [
      {
       "id": 2
      }
     ]
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": "{{ 'Ivan Petrov' in json_stringify($json) }}",
       "list": "OFAC"
      }
     }
    }
   },
   "expect": [
    {
     "node": "$op:DataTable.list",
     "subject": "request",
     "item": "any",
     "path": "params.filter.status",
     "op": "eq",
     "value": "pending"
    }
   ]
  }
 ]
}