{
 "id": "atm_limit_increase",
 "request": "Branch staff request a one-day ATM limit change for a customer on a form: customer id, requested limit and reason. Our standard limit is the ATM daily limit setting. Requests up to twice the standard limit are applied straight away; above that, the branch manager must approve first. Apply the limit with the cards service. Email branch ops (we already have their address set up) about every limit applied above the standard limit, with the customer id and the new limit. Show the staff member the outcome.",
 "apis": [
  "cards.yaml"
 ],
 "tables": {},
 "expect": {
  "trigger": "FormTrigger",
  "must_have_types": [
   "Approval",
   "If|Switch",
   "SendEmail"
  ],
  "must_call": [
   "cards.setLimit"
  ],
  "max_nodes": 14,
  "interface_kind": "form"
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "1500 is applied straight away and branch ops told",
   "input": {
    "items": [
     {
      "customer_id": "C-7",
      "requested_limit": 1500,
      "reason": "travel"
     }
    ]
   },
   "mocks": {
    "$api:cards.setLimit": {
     "http": {
      "status": 200,
      "body": {
       "limit": 1
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$all:Approval?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:cards.setLimit",
     "subject": "request",
     "item": "any",
     "path": "body.limit",
     "op": "eq",
     "value": 1500
    },
    {
     "node": "$api:cards.setLimit",
     "subject": "request",
     "item": "any",
     "path": "url",
     "op": "contains",
     "value": "C-7"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.toEmail",
     "op": "eq",
     "value": "branchops@bank.test"
    },
    {
     "node": "$all:SendEmail",
     "subject": "request",
     "item": "any",
     "path": "params.body",
     "op": "contains",
     "value": "C-7"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Exactly twice the standard needs no approval",
   "input": {
    "items": [
     {
      "customer_id": "C-7",
      "requested_limit": 2000,
      "reason": "travel"
     }
    ]
   },
   "mocks": {
    "$api:cards.setLimit": {
     "http": {
      "status": 200,
      "body": {
       "limit": 1
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$all:Approval?",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$api:cards.setLimit",
     "subject": "node",
     "op": "status",
     "value": "success"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "2001 waits for the manager, then applies",
   "input": {
    "items": [
     {
      "customer_id": "C-7",
      "requested_limit": 2001,
      "reason": "travel"
     }
    ]
   },
   "mocks": {
    "$api:cards.setLimit": {
     "http": {
      "status": 200,
      "body": {
       "limit": 1
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$all:Approval",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "$api:cards.setLimit",
     "subject": "request",
     "item": "any",
     "path": "body.limit",
     "op": "eq",
     "value": 2001
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "At or below the standard: applied, no email",
   "input": {
    "items": [
     {
      "customer_id": "C-7",
      "requested_limit": 1000,
      "reason": "travel"
     }
    ]
   },
   "mocks": {
    "$api:cards.setLimit": {
     "http": {
      "status": 200,
      "body": {
       "limit": 1
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$api:cards.setLimit",
     "subject": "node",
     "op": "status",
     "value": "success"
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  },
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Rejected: not applied, no email",
   "input": {
    "items": [
     {
      "customer_id": "C-7",
      "requested_limit": 5000,
      "reason": "travel"
     }
    ]
   },
   "mocks": {
    "$api:cards.setLimit": {
     "http": {
      "status": 200,
      "body": {
       "limit": 1
      }
     }
    },
    "$all:Approval?": {
     "port": "rejected",
     "approval": {
      "decision": "rejected",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    }
   },
   "expect": [
    {
     "node": "$api:cards.setLimit",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    },
    {
     "node": "$all:SendEmail",
     "subject": "node",
     "op": "status",
     "value": "not_run"
    }
   ]
  }
 ],
 "variables": {
  "WIRE_OPS_EMAIL": {
   "value": "wireops@bank.test"
  },
  "BRANCH_OPS_EMAIL": {
   "value": "branchops@bank.test"
  },
  "FINANCE_OPS_EMAIL": {
   "value": "finops@bank.test"
  },
  "ATM_DAILY_LIMIT": {
   "value": "1000",
   "description": "standard ATM limit per day, USD"
  },
  "COMPLIANCE_EMAIL": {
   "value": "compliance@bank.test"
  },
  "CARDS_API_KEY": {
   "value": "sk-test-123",
   "secret": true
  }
 },
 "subworkflows": [
  {
   "id": "wf_kyc_verify",
