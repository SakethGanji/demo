{
 "id": "business_account_opening",
 "request": "Business account applications are posted to us with company_name, registration_number, country, director_customer_id, director_document_id, expected_monthly_volume and contact_email. First verify the director's identity with our identity check; if they are not verified, decline. Then screen the company name and country for sanctions; a hit is declined and a compliance case is opened naming the company. Then get the company's credit rating. Risk is low if the rating is A or B and the expected monthly volume is at most 1,000,000; high if the rating is D or the volume is over 5,000,000; otherwise medium. Low risk opens automatically. Medium risk needs a compliance officer to approve. High risk needs a compliance officer and then the head of compliance (two different people). Approvers should see a short AI-written risk note about the application. Open approved accounts in the accounts system; if opening fails, reply with an error. Record every application in the business_applications table with company_name, registration_number, risk (when known) and status (opened, declined, rejected or failed). Email the contact the new account number when it opens. Reply with the decision.",
 "apis": [
  "screening.yaml",
  "compliance.yaml",
  "bizbureau.yaml",
  "accounts.yaml"
 ],
 "tables": {
  "business_applications": [
   {
    "name": "company_name",
    "type": "string"
   },
   {
    "name": "registration_number",
    "type": "string"
   },
   {
    "name": "risk",
    "type": "string"
   },
   {
    "name": "status",
    "type": "string"
   }
  ]
 },
 "expect": {
  "trigger": "Webhook",
  "must_have_types": [
   "ExecuteWorkflow",
   "Approval",
   "DataTable",
   "SendEmail",
   "Respond",
   "AIAgent|LLMChat"
  ],
  "must_call": [
   "screening.screen",
   "compliance.openCase",
   "bizbureau.companyRating",
   "accounts.openBusiness"
  ],
  "max_nodes": 40,
  "min_types": {
   "Approval": 2
  }
 },
 "hidden_tests": [
  {
   "target": {
    "kind": "workflow"
   },
   "category": "normal",
   "name": "Low risk opens without approval and emails the account number",
   "input": {
    "items": [
     {
      "body": {
       "company_name": "Northwind Ltd",
       "registration_number": "RN-55",
       "country": "GB",
       "director_customer_id": "C-9",
       "director_document_id": "D-9",
       "expected_monthly_volume": 500000,
       "contact_email": "cfo@northwind.test"
      },
      "headers": {},
      "query": {},
      "method": "POST"
     }
    ]
   },
   "mocks": {
    "$wf:wf_kyc_verify": {
     "items": [
      {
       "verified": true,
       "reason": "ok"
      }
     ]
    },
    "$api:screening.screen": {
     "http": {
      "status": 200,
      "body": {
       "hit": false,
       "list": "OFAC"
      }
     }
    },
    "$api:compliance.openCase": {
     "http": {
      "status": 200,
      "body": {
       "case_id": "CC-1"
      }
     }
    },
    "$api:bizbureau.companyRating": {
     "http": {
      "status": 200,
      "body": {
       "registration_number": "RN-55",
       "rating": "A"
      }
     }
    },
    "$api:accounts.openBusiness": {
     "http": {
      "status": 200,
      "body": {
       "account_number": "BA-100"
      }
     }
    },
    "$all:Approval?": {
     "port": "approved",
     "approval": {
      "decision": "approved",
      "comment": "",
      "form_data": {},
      "decided_by": "test"
     }
    },
    "$op:DataTable.insert|upsert": {
     "items": [
      {
       "id": 1
      }
     ]
    },
    "$all:AIAgent?": {
     "items": [
      {
       "response": "note",
       "structured": {
        "note": "Risk note",
        "summary": "Risk note"
       }
      }
     ]
    },
    "$all:LLMChat?": {
     "items": [
      {
       "response": "Risk note"
      }
     ]
    }
   },
