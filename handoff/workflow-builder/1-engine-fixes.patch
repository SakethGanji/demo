+++ 2/apps/workflow-engine/src/db/migrations/20261030120000_human_task_items.sql
@@ -0,0 +1,18 @@
+-- 20261030120000_human_task_items
+-- Approval "One task per item" (per_item): one node-run can open N tasks at once, one per item. They share
+-- (execution_id, node_name, run_index) - the group the run waits on - and are told apart by item_index (the item's
+-- position in the node's input). Additive: existing rows get item_index 0, so every old task is a group of one.
+
+-- migrate:up
+SET search_path TO "workflow-app";
+
+ALTER TABLE human_tasks ADD COLUMN IF NOT EXISTS item_index INTEGER NOT NULL DEFAULT 0;
+CREATE UNIQUE INDEX IF NOT EXISTS human_tasks_exec_node_item_idx ON human_tasks (execution_id, node_name, run_index, item_index);
+DROP INDEX IF EXISTS human_tasks_exec_node_idx;
+
+-- migrate:down
+SET search_path TO "workflow-app";
+DELETE FROM human_tasks WHERE item_index <> 0;
+CREATE UNIQUE INDEX IF NOT EXISTS human_tasks_exec_node_idx ON human_tasks (execution_id, node_name, run_index);
+DROP INDEX IF EXISTS human_tasks_exec_node_item_idx;
+ALTER TABLE human_tasks DROP COLUMN IF EXISTS item_index;
diff --git 1/apps/workflow-engine/tests/unit/test_approval_per_item_pg.py 2/apps/workflow-engine/tests/unit/test_approval_per_item_pg.py
new file mode 100644
index 0000000..4ba10fc
--- /dev/null
+++ 2/apps/workflow-engine/tests/unit/test_approval_per_item_pg.py
@@ -0,0 +1,301 @@
+"""Approval ``per_item``: one task per item, all open at once; the run resumes once, when the last one is settled.
+
+Real-world shape: managers (one item each) -> Approval(per_item) -> approved / rejected / timed_out, and the escalation
+chain timed_out -> reminder -> a second per_item Approval that asks only the people who did not answer."""
+
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from src.engine import task_resumer
+from src.services.task_service import TaskService
+
+from ._pg_world import CALLS, World, build, install_counter, make_world, nd, remove_counter
+
+pytestmark = pytest.mark.anyio
+
+MANAGERS_CODE = (
+    'return [new_item({"team": "Ops", "email": "ana@bank.example"}), '
+    'new_item({"team": "Risk", "email": "ben@bank.example"}), '
+    'new_item({"team": "Sales", "email": "cy@bank.example"})]'
+)
+
+
+@pytest.fixture
+async def world(pg):
+    install_counter()
+    try:
+        yield await make_world(pg)
+    finally:
+        task_resumer.FAULT.clear()
+        remove_counter()
+
+
+@pytest.fixture
+def notified(monkeypatch):
+    """What the run asked the approver email to send: ``[(task_id, title, to)]`` (no SMTP)."""
+    sent: list[tuple[str, str, list[str]]] = []
+
+    async def fake(session, created, *, workflow_name, project_id):
+        sent.extend((c["task"]["id"], c["task"]["title"], list(c["notify"]["to"])) for c in created)
+
+    monkeypatch.setattr("src.services.approval_notify.notify_created_tasks", fake)
+    return sent
+
+
+def review(name: str = "review", **extra):
+    params = dict(per_item=True, title="Review {{ $json.team }}", context={"team": "{{ $json.team }}"},
+                  notify_email="{{ $json.email }}", assignees=["{{ $json.email }}"], due_in="1h", on_timeout="timed_out")
+    params.update(extra)
+    return nd(name, "Approval", **params)
+
+
+def per_item_flow(code: str = MANAGERS_CODE, *, escalate: bool = False, **review_params):
+    """start -> up -> managers(Code) -> review(Approval per_item) -> yes | no | late.
+    With ``escalate``: review --timed_out--> remind -> review2(Approval per_item) -> yes2 | no2 | late2 (instead of late)."""
+    nodes = [nd("start", "Start"), nd("up"), nd("managers", "Code", code=code), review(**review_params),
+             nd("yes"), nd("no")]
+    conns = [("start", "up"), ("up", "managers"), ("managers", "review"), ("review", "yes", "approved"),
+             ("review", "no", "rejected")]
+    if escalate:
+        nodes += [nd("remind"), review("review2", title="Reminder: {{ $json.team }}"), nd("yes2"), nd("no2"), nd("late2")]
+        conns += [("review", "remind", "timed_out"), ("remind", "review2"), ("review2", "yes2", "approved"),
+                  ("review2", "no2", "rejected"), ("review2", "late2", "timed_out")]
+    else:
+        nodes.append(nd("late"))
+        conns.append(("review", "late", "timed_out"))
+    return build(nodes, conns, name="per-item")
+
+
+async def tasks_at(world: World, exec_id: str, node: str = "review") -> list[dict]:
+    rows = [t for t in await world.tasks_of(exec_id) if t["node_name"] == node]
+    return sorted(rows, key=lambda t: t["item_index"])
+
+
+async def node_output(world: World, exec_id: str, node: str) -> list[dict]:
+    from src.repositories.node_output_repository import NodeOutputRepository
+
+    async with world.sf() as s:
+        rows = [r for r in await NodeOutputRepository(s).get_outputs(exec_id) if r.node_name == node]
+    rows.sort(key=lambda r: r.run_index)
+    return [i["json"] for r in rows for i in (r.output or [])]
+
+
+async def expire(world: World, *task_ids: str) -> None:
+    """The sweeper path: past the deadline, then one scheduler tick (which also kicks the resumes)."""
+    for tid in task_ids:
+        await world.sql("UPDATE human_tasks SET due_at = now() - interval '1 second' WHERE id = :i", i=tid)
+    await asyncio.gather(*await task_resumer.tick(world.sf))
+    await world.settle()
+
+
+async def decide_without_kick(world: World, task_id: str, decision: str = "approved") -> None:
+    async with world.sf() as s:
+        await TaskService(s, kick_resume=False).decide(task_id, decision, None, None, "dana", "k-" + task_id)
+
+
+async def start(world: World, flow) -> str:
+    stored = await world.create(flow)
+    _, ctx = await world.run(stored.id)
+    return ctx.execution_id
+
+
+# ── N items -> N tasks at once ────────────────────────────────────────────────
+
+async def test_three_items_open_three_tasks_at_once_each_resolved_against_its_own_item(world, notified):
+    exec_id = await start(world, per_item_flow())
+    assert (await world.execution(exec_id))["status"] == "waiting"
+    tasks = await tasks_at(world, exec_id)
+    assert len(tasks) == 3 and {t["status"] for t in tasks} == {"open"}
+    assert [t["item_index"] for t in tasks] == [0, 1, 2]
+    assert len({t["run_index"] for t in tasks}) == 1  # one node-run, one group
+    assert [t["title"] for t in tasks] == ["Review Ops", "Review Risk", "Review Sales"]
+    assert [t["context"]["team"] for t in tasks] == ["Ops", "Risk", "Sales"]
+    assert [t["assignees"] for t in tasks] == [["ana@bank.example"], ["ben@bank.example"], ["cy@bank.example"]]
+    assert all(t["due_at"] is not None for t in tasks)
+    by_id = {tid: (title, to) for tid, title, to in notified}
+    assert [by_id[t["id"]] for t in tasks] == [
+        ("Review Ops", ["ana@bank.example"]), ("Review Risk", ["ben@bank.example"]), ("Review Sales", ["cy@bank.example"]),
+    ]
+    assert CALLS == ["up"]
+
+
+async def test_deciding_in_any_order_resumes_once_with_each_items_own_approval(world, notified):
+    exec_id = await start(world, per_item_flow())
+    t0, t1, t2 = await tasks_at(world, exec_id)
+
+    await world.decide(t2["id"], "approved", by="cy", comment="fine")
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "waiting" and CALLS == ["up"]
+    await world.decide(t0["id"], "rejected", by="ana", comment="too much")
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "waiting" and CALLS == ["up"]
+    await world.decide(t1["id"], "approved", by="ben")
+    await world.settle()
+
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "no"]  # downstream ran once per port, on the combined outputs
+    yes = await node_output(world, exec_id, "yes")
+    assert [(i["team"], i["approval"]["decided_by"], i["approval"]["task_id"]) for i in yes] == [
+        ("Risk", "ben", t1["id"]), ("Sales", "cy", t2["id"]),
+    ]  # input order, each with its own task
+    assert yes[1]["approval"]["comment"] == "fine" and yes[1]["approval"]["decision"] == "approved"
+    [no] = await node_output(world, exec_id, "no")
+    assert no["team"] == "Ops" and no["approval"] == {
+        "decision": "rejected", "comment": "too much", "form_data": {}, "decided_by": "ana",
+        "decided_at": no["approval"]["decided_at"], "task_id": t0["id"],
+    }
+    assert {t["resume_state"] for t in await tasks_at(world, exec_id)} == {"done"}
+    assert await task_resumer.sweep_pending(world.sf, min_age_s=0) == []  # nothing left to resume
+
+
+async def test_a_mix_of_approved_rejected_and_timed_out_via_the_sweeper(world, notified):
+    exec_id = await start(world, per_item_flow())
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await world.decide(t0["id"], "approved")
+    await world.decide(t1["id"], "rejected")
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "waiting"
+
+    await expire(world, t2["id"])
+
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "no", "late"]
+    assert [i["team"] for i in await node_output(world, exec_id, "yes")] == ["Ops"]
+    assert [i["team"] for i in await node_output(world, exec_id, "no")] == ["Risk"]
+    [late] = await node_output(world, exec_id, "late")
+    assert late["team"] == "Sales" and late["approval"]["decision"] == "timed_out"
+    assert late["approval"]["decided_by"] == "system:timeout" and late["approval"]["task_id"] == t2["id"]
+
+
+async def test_on_timeout_reject_sends_an_expired_item_to_rejected(world, notified):
+    exec_id = await start(world, per_item_flow(on_timeout="reject"))
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await world.decide(t1["id"], "approved")
+    await world.settle()
+    await expire(world, t0["id"], t2["id"])  # two expire in one sweep: still one resume
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "no"]
+    assert [i["team"] for i in await node_output(world, exec_id, "no")] == ["Ops", "Sales"]
+
+
+# ── escalation: timed_out -> reminder -> a second per_item Approval ────────────
+
+async def test_escalation_asks_only_the_timed_out_people_again(world, notified):
+    exec_id = await start(world, per_item_flow(escalate=True))
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await world.decide(t0["id"], "approved")
+    await world.settle()
+    await expire(world, t1["id"], t2["id"])
+
+    assert (await world.execution(exec_id))["status"] == "waiting"  # paused again, at the second Approval
+    assert CALLS == ["up", "yes", "remind"]
+    r1, r2 = await tasks_at(world, exec_id, "review2")
+    assert [r["title"] for r in (r1, r2)] == ["Reminder: Risk", "Reminder: Sales"]
+    assert [r["context"]["team"] for r in (r1, r2)] == ["Risk", "Sales"]
+    assert {r["status"] for r in (r1, r2)} == {"open"}
+    reminded = {tid: to for tid, _, to in notified}
+    assert reminded[r1["id"]] == ["ben@bank.example"] and reminded[r2["id"]] == ["cy@bank.example"]
+
+    await world.decide(r2["id"], "rejected")
+    await world.decide(r1["id"], "approved")
+    await world.settle()
+
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "remind", "yes2", "no2"]
+    assert [i["team"] for i in await node_output(world, exec_id, "yes")] == ["Ops"]
+    [y2] = await node_output(world, exec_id, "yes2")
+    assert y2["team"] == "Risk" and y2["approval"]["task_id"] == r1["id"]
+    [n2] = await node_output(world, exec_id, "no2")
+    assert n2["team"] == "Sales" and n2["approval"]["decision"] == "rejected"
+
+
+# ── resume exactly once ───────────────────────────────────────────────────────
+
+async def test_concurrent_decides_of_the_last_two_tasks_resume_once(world, notified):
+    exec_id = await start(world, per_item_flow())
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await world.decide(t0["id"], "approved")
+    await world.settle()
+    await asyncio.gather(world.decide(t1["id"], "approved"), world.decide(t2["id"], "rejected"))
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "no"]
+    assert [i["team"] for i in await node_output(world, exec_id, "yes")] == ["Ops", "Risk"]
+
+
+async def test_competing_claims_of_a_settled_group_resume_once(world, notified):
+    exec_id = await start(world, per_item_flow())
+    tasks = await tasks_at(world, exec_id)
+    for t in tasks:
+        await decide_without_kick(world, t["id"])
+    outcomes = await asyncio.gather(*[task_resumer.claim_and_resume(t["id"], world.sf) for t in tasks for _ in range(2)])
+    assert outcomes.count("resumed") == 1
+    assert set(outcomes) <= {"resumed", "not_pending", "busy", "waiting"}
+    await world.settle()
+    assert CALLS == ["up", "yes"]
+    assert len(await node_output(world, exec_id, "yes")) == 3
+    assert await task_resumer.sweep_pending(world.sf, min_age_s=0) == []
+
+
+async def test_a_sweeper_timeout_and_a_person_at_the_same_moment_resume_once(world, notified):
+    exec_id = await start(world, per_item_flow())
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await world.decide(t0["id"], "approved")
+    await world.settle()
+    await world.sql("UPDATE human_tasks SET due_at = now() - interval '1 second' WHERE id = :i", i=t2["id"])
+    started, _ = await asyncio.gather(task_resumer.tick(world.sf), world.decide(t1["id"], "approved"))
+    await asyncio.gather(*started)
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "late"]
+    assert [i["team"] for i in await node_output(world, exec_id, "yes")] == ["Ops", "Risk"]
+
+
+async def test_a_partly_decided_group_is_resumed_by_the_sweep_once_the_last_is_decided(world, notified):
+    exec_id = await start(world, per_item_flow())
+    t0, t1, t2 = await tasks_at(world, exec_id)
+    await decide_without_kick(world, t0["id"])
+    await decide_without_kick(world, t1["id"])
+    await asyncio.gather(*await task_resumer.sweep_pending(world.sf, min_age_s=0))
+    assert (await world.execution(exec_id))["status"] == "waiting" and CALLS == ["up"]
+    await decide_without_kick(world, t2["id"], "rejected")
+    await asyncio.gather(*await task_resumer.sweep_pending(world.sf, min_age_s=0))
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up", "yes", "no"]
+
+
+# ── edges: per_item false, 0 items, 1 item ────────────────────────────────────
+
+async def test_per_item_false_is_one_task_for_every_item(world, notified):
+    exec_id = await start(world, per_item_flow(per_item=False, title="Review all"))
+    [t] = await tasks_at(world, exec_id)
+    assert t["title"] == "Review all" and t["item_index"] == 0
+    await world.decide(t["id"], "approved")
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "success"
+    yes = await node_output(world, exec_id, "yes")
+    assert [i["team"] for i in yes] == ["Ops", "Risk", "Sales"]
+    assert {i["approval"]["task_id"] for i in yes} == {t["id"]}
+
+
+async def test_zero_items_make_no_tasks_and_emit_nothing(world, notified):
+    exec_id = await start(world, per_item_flow(code="return []"))
+    assert await world.tasks_of(exec_id) == []
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["up"]
+
+
+async def test_one_item_behaves_like_a_plain_approval(world, notified):
+    exec_id = await start(world, per_item_flow(code='return [new_item({"team": "Ops", "email": "ana@bank.example"})]'))
+    [t] = await tasks_at(world, exec_id)
+    assert t["title"] == "Review Ops"
+    await world.decide(t["id"], "rejected")
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "success"
+    [no] = await node_output(world, exec_id, "no")
+    assert no["team"] == "Ops" and no["approval"]["task_id"] == t["id"]
+    assert CALLS == ["up", "no"]
diff --git 1/apps/workflow-engine/tests/unit/test_loop_approval_resume_pg.py 2/apps/workflow-engine/tests/unit/test_loop_approval_resume_pg.py
new file mode 100644
index 0000000..95750a0
--- /dev/null
+++ 2/apps/workflow-engine/tests/unit/test_loop_approval_resume_pg.py
@@ -0,0 +1,129 @@
+"""A Loop whose body pauses at an Approval keeps its pending items across every pause/resume.
+
+Real-world shape: rows -> Code (group into N items) -> Loop(batchSize 1) --loop--> Approval --approved/rejected--> ... ->
+write --main--> back to Loop, Loop --done--> summary. Each pause stores a resume snapshot and the run is re-entered in a
+fresh runner; the Loop's per-execution state (``node_internal_state``) must travel with that snapshot, or the second
+iteration emits the loop-back item as though it were the next item."""
+
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from src.engine import task_resumer
+
+from ._pg_world import CALLS, World, build, install_counter, make_world, nd, remove_counter
+
+pytestmark = pytest.mark.anyio
+
+GROUP_CODE = 'return [new_item({"group": "A", "n": 1}), new_item({"group": "B", "n": 2})]'
+
+
+@pytest.fixture
+async def world(pg):
+    install_counter()
+    try:
+        yield await make_world(pg)
+    finally:
+        task_resumer.FAULT.clear()
+        remove_counter()
+
+
+def loop_with_approval(*, reminder: bool = False):
+    """start -> rows -> group(Code, 2 items) -> loop --loop--> review(Approval) --approved/rejected--> after -> write -> loop;
+    loop --done--> summary. With ``reminder``: review --timed_out--> remind -> review2(Approval) --approved--> after."""
+    nodes = [
+        nd("start", "Start"), nd("rows"), nd("group", "Code", code=GROUP_CODE), nd("loop", "Loop", batchSize=1),
+        nd("review", "Approval", context={"group": "{{ $json.group }}", "n": "{{ $json.n }}"}, due_in="1h",
+           on_timeout="timed_out"),
+        nd("after"), nd("write"), nd("summary"),
+    ]
+    conns = [
+        ("start", "rows"), ("rows", "group"), ("group", "loop"), ("loop", "review", "loop"),
+        ("review", "after", "approved"), ("review", "after", "rejected"), ("after", "write"), ("write", "loop"),
+        ("loop", "summary", "done"),
+    ]
+    if reminder:
+        nodes += [nd("remind"), nd("review2", "Approval", context={"group": "{{ $json.group }}", "again": True})]
+        conns += [("review", "remind", "timed_out"), ("remind", "review2"), ("review2", "after", "approved")]
+    return build(nodes, conns, name="loop-approval")
+
+
+async def open_tasks(world: World, exec_id: str, node: str) -> list[dict]:
+    return [t for t in await world.tasks_of(exec_id) if t["node_name"] == node]
+
+
+async def node_output(world: World, exec_id: str, node: str) -> list[dict]:
+    from src.repositories.node_output_repository import NodeOutputRepository
+
+    async with world.sf() as s:
+        rows = [r for r in await NodeOutputRepository(s).get_outputs(exec_id) if r.node_name == node]
+    rows.sort(key=lambda r: r.run_index)
+    return [i["json"] for r in rows for i in (r.output or [])]
+
+
+async def test_each_loop_item_gets_its_own_approval_and_done_fires_once_after_both(world):
+    stored = await world.create(loop_with_approval())
+    _, ctx = await world.run(stored.id)
+    exec_id = ctx.execution_id
+    assert (await world.execution(exec_id))["status"] == "waiting"
+
+    [t1] = await open_tasks(world, exec_id, "review")
+    assert t1["context"]["group"] == "A" and t1["context"]["n"] == 1
+    await world.decide(t1["id"], "approved")
+    await world.settle()
+
+    assert (await world.execution(exec_id))["status"] == "waiting"  # paused again on the second item
+    tasks = await open_tasks(world, exec_id, "review")
+    assert len(tasks) == 2
+    t2 = next(t for t in tasks if t["id"] != t1["id"])
+    assert t2["context"]["group"] == "B" and t2["context"]["n"] == 2  # its own data, not the loop-back item
+    assert "summary" not in CALLS
+
+    await world.decide(t2["id"], "rejected")
+    await world.settle()
+
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["rows", "after", "write", "after", "write", "summary"]  # done fired once, after both
+    writes = await node_output(world, exec_id, "write")
+    assert [(w["group"], w["approval"]["decision"]) for w in writes] == [("A", "approved"), ("B", "rejected")]
+    [summary] = await node_output(world, exec_id, "summary")
+    assert summary["_loop_completed"] is True and summary["total_items"] == 2
+    assert [i["group"] for i in summary["items"]] == ["A", "B"]
+
+
+async def test_a_timeout_then_a_second_approval_inside_one_iteration_keeps_the_loop_items(world):
+    stored = await world.create(loop_with_approval(reminder=True))
+    _, ctx = await world.run(stored.id)
+    exec_id = ctx.execution_id
+
+    [t1] = await open_tasks(world, exec_id, "review")
+    assert t1["context"]["group"] == "A"
+    # the first approval expires: the run takes timed_out -> remind -> a second Approval (pause #2 in iteration 1)
+    await world.sql("UPDATE human_tasks SET due_at = now() - interval '1 second' WHERE id = :i", i=t1["id"])
+    await asyncio.gather(*await task_resumer.tick(world.sf))
+    await world.settle()
+    assert (await world.execution(exec_id))["status"] == "waiting"
+    [r2] = await open_tasks(world, exec_id, "review2")
+    assert r2["context"]["group"] == "A" and r2["context"]["again"] is True
+
+    await world.decide(r2["id"], "approved")
+    await world.settle()
+
+    # iteration 2 reaches the first Approval again with item B
+    tasks = await open_tasks(world, exec_id, "review")
+    assert len(tasks) == 2
+    t2 = next(t for t in tasks if t["id"] != t1["id"])
+    assert t2["context"]["group"] == "B" and t2["context"]["n"] == 2
+    assert "summary" not in CALLS
+
+    await world.decide(t2["id"], "approved")
+    await world.settle()
+
+    assert (await world.execution(exec_id))["status"] == "success"
+    assert CALLS == ["rows", "remind", "after", "write", "after", "write", "summary"]
+    writes = await node_output(world, exec_id, "write")
+    assert [w["group"] for w in writes] == ["A", "B"]
+    [summary] = await node_output(world, exec_id, "summary")
+    assert summary["total_items"] == 2
diff --git 1/apps/workflow-engine/tests/unit/test_postgres_transaction_per_item_pg.py 2/apps/workflow-engine/tests/unit/test_postgres_transaction_per_item_pg.py
new file mode 100644
index 0000000..18b4e4f
--- /dev/null
+++ 2/apps/workflow-engine/tests/unit/test_postgres_transaction_per_item_pg.py
@@ -0,0 +1,66 @@
+"""Postgres `transaction` runs once per input item, like `query` does.
+
+It used to resolve the statements against item 0 only and emit one result: two managers' outcomes reached an audit
+write and only the first one's row was ever written, with the run reporting success.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import psycopg
+import pytest
+
+from src.engine.expression_engine import ExpressionEngine, expression_engine
+from src.engine.types import NodeData, NodeDefinition
+from src.nodes.integrations.postgres import PostgresNode
+
+pytestmark = pytest.mark.anyio
+
+
+def conninfo(db) -> str:
+    e = db.env()
+    return f"postgresql://{e['WORKFLOW_DB_USER']}:{e['WORKFLOW_DB_PASSWORD']}@{e['WORKFLOW_DB_HOST']}:{e['WORKFLOW_DB_PORT']}/{db.name}"
+
+
+@pytest.fixture
+async def table(pg_dbname):
+    url = conninfo(pg_dbname)
+    async with await psycopg.AsyncConnection.connect(url, autocommit=True) as c:
+        await c.execute("DROP TABLE IF EXISTS public.tx_audit")
+        await c.execute("CREATE TABLE public.tx_audit (who text NOT NULL, action text NOT NULL)")
+    yield url
+    async with await psycopg.AsyncConnection.connect(url, autocommit=True) as c:
+        await c.execute("DROP TABLE IF EXISTS public.tx_audit")
+
+
+async def rows(url):
+    async with await psycopg.AsyncConnection.connect(url) as c:
+        cur = await c.execute("SELECT who, action FROM public.tx_audit ORDER BY who")
+        return await cur.fetchall()
+
+
+def run(url, items, statements):
+    node = PostgresNode()
+    nd = NodeDefinition(name="Write audit", type="Postgres", parameters={"operation": "transaction", "statements": statements})
+    ctx = SimpleNamespace(execution_id="ex", node_states={})
+    data = [NodeData(json=i) for i in items]
+    return node._exec_transaction(url, nd, data, data, ctx, expression_engine, ExpressionEngine)
+
+
+STMTS = [{"query": "INSERT INTO public.tx_audit (who, action) VALUES (%s, %s)", "params": ["{{ $json.who }}", "{{ $json.action }}"]}]
+
+
+async def test_each_item_gets_its_own_transaction(table):
+    res = await run(table, [{"who": "m1", "action": "revoked_some"}, {"who": "m2", "action": "confirmed"}], STMTS)
+    out = res.outputs["main"]
+    assert [o.json["success"] for o in out] == [True, True]
+    assert await rows(table) == [("m1", "revoked_some"), ("m2", "confirmed")]
+
+
+async def test_a_failing_item_rolls_back_only_itself(table):
+    # m2's action is NULL: its insert fails and rolls back; m1 and m3 are still written
+    res = await run(table, [{"who": "m1", "action": "a"}, {"who": "m2", "action": None}, {"who": "m3", "action": "c"}], STMTS)
+    out = res.outputs["main"]
+    assert [o.json["success"] for o in out] == [True, False, True]
+    assert out[1].json["rolledBack"] is True
+    assert await rows(table) == [("m1", "a"), ("m3", "c")]
diff --git 1/apps/workflow-engine/tests/unit/test_json_template_structures.py 2/apps/workflow-engine/tests/unit/test_json_template_structures.py
new file mode 100644
index 0000000..8b0bdac
--- /dev/null
+++ 2/apps/workflow-engine/tests/unit/test_json_template_structures.py
@@ -0,0 +1,35 @@
+"""resolve_json_template on parameters stored as real JSON (a list or object), not a JSON string.
+
+Postgres queryParameters / statements are `json` properties: the UI stores a string, but a workflow written as
+JSON (the builder, an import, the API) holds a real list. Both must resolve {{ $json... }} per item; a list used to
+come back untouched, so the query ran with the literal "{{ ... }}" text as its parameter.
+"""
+from src.engine.expression_engine import ExpressionEngine, expression_engine
+from src.engine.types import NodeData
+
+
+def ctx():
+    items = [NodeData(json={"body": {"loan_id": "L1", "months": 3}, "plan": "holiday"})]
+    return ExpressionEngine.create_context(items, {}, "exec_t", 0)
+
+
+def test_list_params_resolve_typed():
+    out = expression_engine.resolve_json_template(["{{ $json.body.loan_id }}", "{{ $json.body.months }}", "fixed"], ctx())
+    assert out == ["L1", 3, "fixed"]
+
+
+def test_statements_list_resolves_nested_params():
+    stmts = [{"query": "UPDATE t SET plan = %s WHERE id = %s", "params": ["{{ $json.plan }}", "{{ $json.body.loan_id }}"]},
+             {"query": "INSERT INTO a VALUES (%s)", "params": ["loan {{ $json.body.loan_id }}"]}]
+    out = expression_engine.resolve_json_template(stmts, ctx())
+    assert out[0]["params"] == ["holiday", "L1"]
+    assert out[1]["params"] == ["loan L1"]
+    assert out[0]["query"] == stmts[0]["query"]
+
+
+def test_dict_named_params_resolve():
+    assert expression_engine.resolve_json_template({"id": "{{ $json.body.loan_id }}"}, ctx()) == {"id": "L1"}
+
+
+def test_string_form_unchanged():
+    assert expression_engine.resolve_json_template('["{{ $json.body.loan_id }}"]', ctx()) == ["L1"]
