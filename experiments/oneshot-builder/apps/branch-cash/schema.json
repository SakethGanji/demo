  "queries": [
    {
      "name": "monthly_variance_by_branch",
      "sql": "SELECT b.name AS branch, strftime('%Y-%m', c.count_date) AS month, COUNT(*) AS counts, SUM(c.variance) AS net_variance, SUM(ABS(c.variance)) AS gross_variance FROM cash_counts c JOIN branches b ON b.id = c.branch_id GROUP BY b.name, strftime('%Y-%m', c.count_date) ORDER BY month DESC, b.name"
    },
    {
      "name": "my_pending_signoffs",
      "sql": "SELECT c.id, b.name AS branch, t.name AS teller, c.count_date, c.variance, c.note FROM cash_counts c JOIN branches b ON b.id = c.branch_id JOIN tellers t ON t.id = c.teller_id WHERE c.status = 'needs_signoff' AND b.manager_email = :me ORDER BY c.count_date"
    },
    {
      "name": "tellers_by_branch",
      "sql": "SELECT b.name AS branch, t.name AS teller, t.email, t.active FROM tellers t JOIN branches b ON b.id = t.branch_id ORDER BY b.name, t.name"
    }
  ]
