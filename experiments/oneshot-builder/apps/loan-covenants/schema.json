  "queries": [
    {
      "name": "open_breaches",
      "sql": "SELECT l.borrower, l.relationship_manager, c.covenant_type, c.direction, c.threshold, t.period, t.actual_value FROM covenants c JOIN loans l ON l.id = c.loan_id LEFT JOIN covenant_tests t ON t.covenant_id = c.id AND t.id = (SELECT MAX(id) FROM covenant_tests WHERE covenant_id = c.id) WHERE c.status = 'breached' ORDER BY l.borrower"
    },
    {
      "name": "pending_waivers",
      "sql": "SELECT w.id, l.borrower, c.covenant_type, w.reason, w.requested_by, w.created_at FROM waivers w JOIN covenants c ON c.id = w.covenant_id JOIN loans l ON l.id = c.loan_id WHERE w.status = 'requested' ORDER BY w.created_at"
    },
    {
      "name": "my_loan_covenants",
      "sql": "SELECT l.borrower, c.id AS covenant_id, c.covenant_type, c.direction, c.threshold, c.frequency, c.status FROM loans l JOIN covenants c ON c.loan_id = l.id WHERE l.relationship_manager = :me AND l.status != 'paid_off' ORDER BY l.borrower, c.id"
    }
  ]
}