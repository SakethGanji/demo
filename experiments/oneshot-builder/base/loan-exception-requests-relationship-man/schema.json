{
  "roles": [
    "relationship_manager",
    "credit_officer",
    "chief_credit_officer"
  ],
  "tables": [
    {
      "name": "waiver_requests",
      "columns": [
        {
          "name": "borrower",
          "type": "text",
          "required": true
        },
        {
          "name": "loan_number",
          "type": "text",
          "required": true
        },
        {
          "name": "exception_type",
          "type": "text"
        },
        {
          "name": "amount",
          "type": "money",
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "required": true
        },
        {
          "name": "status",
          "type": "choice",
          "choices": [
            "pending_credit_officer",
            "pending_chief_credit_officer",
            "approved",
            "rejected"
          ],
          "required": true
        },
        {
          "name": "requester_email",
          "type": "person",
          "required": true
        },
        {
          "name": "decided_by",
          "type": "person"
        },
        {
          "name": "decided_at",
          "type": "datetime"
        },
        {
          "name": "decision_note",
          "type": "text"
        }
      ],
      "sample_rows": [
        {
          "borrower": "Harborview Dental Group",
          "loan_number": "LN-10421",
          "exception_type": "Covenant waiver",
          "amount": 85000,
          "reason": "DSCR slightly below covenant for Q2",
