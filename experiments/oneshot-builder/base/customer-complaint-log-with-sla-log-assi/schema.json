{
  "roles": [
    "agent",
    "supervisor"
  ],
  "tables": [
    {
      "name": "complaints",
      "columns": [
        {
          "name": "customer_name",
          "type": "text",
          "required": true
        },
        {
          "name": "customer_email",
          "type": "email"
        },
        {
          "name": "channel",
          "type": "choice",
          "choices": [
            "phone",
            "email",
            "branch",
            "web",
            "letter"
          ],
          "required": true
        },
        {
          "name": "summary",
          "type": "text",
          "required": true
        },
        {
          "name": "status",
          "type": "choice",
          "choices": [
            "new",
            "assigned",
            "responded",
            "closed"
          ],
          "required": true
        },
        {
          "name": "assignee",
          "type": "person"
        },
        {
          "name": "received_on",
          "type": "date",
          "required": true
        },
        {
          "name": "sla_due",
          "type": "date",
          "required": true
        },
        {
          "name": "responded_at",
          "type": "datetime"
        },
        {
          "name": "response_note",
          "type": "text"
        },
        {
          "name": "closed_at",
          "type": "datetime"
        }
      ],
      "sample_rows": [
