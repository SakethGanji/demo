{
  "roles": [
    "ap",
    "manager"
  ],
  "tables": [
    {
      "name": "invoices",
      "columns": [
        {
          "name": "vendor",
          "type": "text",
          "required": true
        },
        {
          "name": "amount",
          "type": "money",
          "required": true
        },
        {
          "name": "status",
          "type": "choice",
          "choices": [
            "needs_approval",
            "ready_to_pay",
            "rejected",
            "paid"
          ],
          "required": true
        },
        {
          "name": "submitter_email",
          "type": "email",
          "required": true
        },
        {
          "name": "due_date",
          "type": "date"
        },
        {
          "name": "approved_by",
          "type": "person"
        },
        {
          "name": "rejection_reason",
          "type": "text"
        },
        {
          "name": "paid_on",
          "type": "date"
        }
      ],
      "sample_rows": [
        {
          "vendor": "Iron Mountain",
          "amount": 12400,
          "status": "needs_approval",
          "submitter_email": "r.alvarez@bank.example",
          "due_date": "2026-11-05"
        },
        {
          "vendor": "Cintas Uniforms",
          "amount": 860.5,
          "status": "ready_to_pay",
          "submitter_email": "r.alvarez@bank.example",
          "due_date": "2026-10-30"
        },
        {
          "vendor": "Diebold Nixdorf",
          "amount": 27500,
          "status": "ready_to_pay",
          "submitter_email": "t.nguyen@bank.example",
          "due_date": "2026-11-12",
          "approved_by": "m.chen@bank.example"
        },
        {
          "vendor": "Staples Business",
          "amount": 1425,
          "status": "paid",
          "submitter_email": "t.nguyen@bank.example",
          "due_date": "2026-10-10",
          "paid_on": "2026-10-09"
        },
        {
          "vendor": "Brightline Consulting",
          "amount": 8900,
          "status": "rejected",
          "submitter_email": "r.alvarez@bank.example",
          "due_date": "2026-10-25",
          "approved_by": "m.chen@bank.example",
          "rejection_reason": "No signed statement of work on file"
        },
        {
          "vendor": "Iron Mountain",
          "amount": 5300,
          "status": "needs_approval",
          "submitter_email": "t.nguyen@bank.example",
          "due_date": "2026-11-15"
        }
      ]
    }
  ],
  "queries": [
    {
      "name": "open_by_vendor",
      "sql": "SELECT vendor, SUM(amount) AS total FROM invoices WHERE status != 'paid' AND status != 'rejected' GROUP BY vendor"
    },
    {
      "name": "awaiting_approval",
      "sql": "SELECT id, vendor, amount, submitter_email, due_date FROM invoices WHERE status = 'needs_approval' ORDER BY due_date"
    },
    {
      "name": "my_submitted",
      "sql": "SELECT id, vendor, amount, status, due_date FROM invoices WHERE submitter_email = :me ORDER BY created_at DESC"
    },
    {
      "name": "overdue_unpaid",
      "sql": "SELECT id, vendor, amount, status, due_date FROM invoices WHERE status IN ('needs_approval', 'ready_to_pay') AND due_date < :today ORDER BY due_date"
    }
  ]
}