{
  "roles": [
    "member",
    "manager",
    "it"
  ],
  "tables": [
    {
      "name": "access_requests",
      "columns": [
        {
          "name": "system",
          "type": "text",
          "required": true
        },
        {
          "name": "reason",
          "type": "text"
        },
        {
          "name": "requester_email",
          "type": "person",
          "required": true
        },
        {
          "name": "manager_email",
          "type": "person",
          "required": true
        },
        {
          "name": "status",
          "type": "choice",
          "choices": [
            "pending_approval",
            "approved",
            "rejected",
            "completed"
          ],
          "required": true
        },
        {
          "name": "decision_note",
          "type": "text"
        },
        {
          "name": "decided_at",
          "type": "datetime"
        },
        {
          "name": "completed_by",
          "type": "person"
        },
        {
          "name": "completed_at",
          "type": "datetime"
        }
      ],
      "sample_rows": [
