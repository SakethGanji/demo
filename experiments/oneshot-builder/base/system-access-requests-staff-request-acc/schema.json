  ],
  "queries": [
    {
      "name": "my_requests",
      "sql": "SELECT id, system, status, decision_note, created_at FROM access_requests WHERE requester_email = :me ORDER BY created_at DESC"
    },
    {
      "name": "awaiting_my_approval",
      "sql": "SELECT id, system, reason, requester_email, created_at FROM access_requests WHERE manager_email = :me AND status = 'pending_approval' ORDER BY created_at"
    },
    {
      "name": "it_queue",
      "sql": "SELECT id, system, requester_email, decided_at, CAST(julianday(:today) - julianday(decided_at) AS INTEGER) AS days_waiting FROM access_requests WHERE status = 'approved' ORDER BY decided_at"
    },
    {
      "name": "open_by_status",
      "sql": "SELECT status, COUNT(*) AS total FROM access_requests WHERE status IN ('pending_approval', 'approved') GROUP BY status"
    }
  ]
}